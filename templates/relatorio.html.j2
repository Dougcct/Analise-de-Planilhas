    sec.innerHTML = '<div class="ed-sec-bar no-print">' +
      '<button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>' +
      '<button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>' +
      '<button type="button" class="ed-mini-btn perigo" onclick="this.closest(\'section\').remove()">✕ Excluir bloco</button></div>' +
      '<h2 data-editavel="1" contenteditable="true">Nota complementar</h2>' +
      '<div class="grade-paineis"><div class="painel" data-painel-id="' + eid + '--p0" data-painel-nome="Nota" data-larg="12">' +
      '<p class="desc" data-editavel="1" contenteditable="true">Digite aqui observações, contexto para outros setores ou conclusões para impressão…</p>' +
      '</div></div>';
    v0.appendChild(sec);
    sec.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  window.edColetarEstado = function () {
    var secOcultas = [];
    var todasSecs = document.querySelectorAll('section[data-sec-id]');
    for (var i = 0; i < todasSecs.length; i++) {
      if (todasSecs[i].getAttribute('data-oculto') === '1') {
        var sid = todasSecs[i].getAttribute('data-sec-id');
        if (secOcultas.indexOf(sid) === -1) secOcultas.push(sid);
      }
    }
    var v0 = document.querySelector('.vista[data-i="0"]');
    var ordemSecoes = [], titulosSecoes = {}, blocosExtras = [], paineisOcultos = [], ordemPaineis = {}, layoutPaineis = {}, graficosCustom = [];
    if (v0) {
      var secsV0 = v0.querySelectorAll('section[data-sec-id]');
      for (var s = 0; s < secsV0.length; s++) {
        var sec = secsV0[s];
        var idSec = sec.getAttribute('data-sec-id');
        if (idSec !== 'filtros' && idSec !== 'exec' && idSec !== 'resumo') {
          ordemSecoes.push(idSec);
        }
        var h2 = sec.querySelector('h2');
        if (h2) titulosSecoes[idSec] = h2.textContent.trim();
        if (sec.getAttribute('data-extra') === '1' && sec.getAttribute('data-oculto') !== '1') {
          var pDesc = sec.querySelector('.desc');
          var pnEx = sec.querySelector('.painel');
          blocosExtras.push({
            id: idSec,
            titulo: h2 ? h2.textContent.trim() : 'Nota complementar',
            texto: pDesc ? pDesc.textContent.trim() : '',
            meia: pnEx ? pnEx.classList.contains('meia') : false
          });
        }
        var pns = sec.querySelectorAll('.painel[data-painel-id]');
        ordemPaineis[idSec] = [];
        for (var p = 0; p < pns.length; p++) {
          var pn = pns[p];
          var pid = pn.getAttribute('data-painel-id');
          ordemPaineis[idSec].push(pid);
          if (pn.getAttribute('data-oculto') === '1') paineisOcultos.push(pid);
          var h3 = pn.querySelector('h3');
          var dEl = pn.querySelector('p.desc');
          var det = pn.querySelector('.painel-tab-wrap details');
          var plarg = parseInt(pn.getAttribute('data-larg') || (pn.classList.contains('meia') ? '6' : '12'), 10);
          var palt = parseInt(pn.getAttribute('data-altura') || '0', 10);
          layoutPaineis[pid] = {
            meia: plarg === 6,
            largura: plarg,
            altura: palt,
            aberta: det ? det.open : (pn.getAttribute('data-aberta') === '1'),
            ocultar_figura: pn.getAttribute('data-ocultar-fig') === '1',
            ocultar_tabela: pn.getAttribute('data-ocultar-tab') === '1',
            titulo: h3 ? h3.textContent.trim() : pn.getAttribute('data-painel-nome'),
            descricao: dEl ? dEl.textContent.trim() : null
          };
          if (pn.getAttribute('data-custom-graf') === '1' && pn.getAttribute('data-oculto') !== '1') {
            var fw = pn.querySelector('.painel-fig-wrap');
            graficosCustom.push({
              id: pid,
              secao_id: idSec,
              titulo: h3 ? h3.textContent.trim() : 'Gráfico personalizado',
              descricao: dEl ? dEl.textContent.trim() : '',
              largura: plarg,
              altura: palt,
              figura_html: fw ? fw.innerHTML : ''
            });
          }
        }
      }
    }
    var achados = [];
    var lis = document.querySelectorAll('#lista-achados-v0 li span[data-editavel="1"]');
    for (var a = 0; a < lis.length; a++) {
      var txt = lis[a].textContent.trim();
      if (txt) achados.push(txt);
    }
    var h1 = document.getElementById('rel-titulo-h1');
    var sub = document.getElementById('rel-sub-p');
    var resLead = document.getElementById('resumo-lead-v0');
    var obs = document.getElementById('obs-gestor-v0');
    return {
      titulo: h1 ? h1.textContent.trim() : '',
      sub: sub ? sub.textContent.trim() : '',
      resumo: resLead ? resLead.textContent.trim() : '',
      observacoes: obs ? obs.textContent.trim() : null,
      achados: achados,
      config_exec: window.execColetarCfg(),
      secoes_ocultas: secOcultas,
      ordem_secoes: ordemSecoes,
      titulos_secoes: titulosSecoes,
      paineis_ocultos: paineisOcultos,
      ordem_paineis: ordemPaineis,
      layout_paineis: layoutPaineis,
      blocos_extras: blocosExtras,
      graficos_custom: graficosCustom
    };
  };

  window.edSalvarNoServidor = function () {
    if (!SLUG) return;
    var fb = document.getElementById('ed-feedback');
    if (fb) fb.textContent = 'Salvando versão editada…';
    fetch('/web/r/' + encodeURIComponent(SLUG) + '/versao-editada', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(window.edColetarEstado())
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (fb) fb.textContent = d.ok ? '✔ Versão editada salva! pronta p/ compartilhar ou imprimir.' : ('Erro: ' + (d.erro || 'falha'));
      try {
        if (window.parent && window.parent !== window && window.parent.notificarVersaoEditadaSalva) {
          window.parent.notificarVersaoEditadaSalva();
        }
      } catch (e) {}
    }).catch(function () {
      if (fb) fb.textContent = 'Erro ao salvar versão editada.';
    });
  };

  window.edBaixarHtml = function () {
    var clone = document.documentElement.cloneNode(true);
    var bodyClone = clone.querySelector('body');
    if (bodyClone) bodyClone.classList.remove('modo-editavel');
    var rem = clone.querySelectorAll('[data-oculto="1"], #barra-editavel, #modal-novo-grafico, .ed-sec-bar, .ed-painel-bar, .ed-kpi-bar, .ed-achado-del, .exec-cfg, .exec-edit-btn, #btn-gerar-editavel');
    for (var i = 0; i < rem.length; i++) rem[i].remove();
    var eds = clone.querySelectorAll('[contenteditable]');
    for (var j = 0; j < eds.length; j++) eds[j].removeAttribute('contenteditable');
    var htmlTxt = '<!doctype html>\n' + clone.outerHTML;
    var blob = new Blob([htmlTxt], { type: 'text/html;charset=utf-8' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = (SLUG || 'relatorio') + '-versao-editada.html';
    document.body.appendChild(a);
    a.click();
    setTimeout(function () { a.remove(); }, 200);
  };

  if (document.body.classList.contains('modo-editavel')) {
    edAtualizarEditaveis(true);
    edAtualizarListaOcultos();
  }

  // ---- filtros de dimensão (Convênio, Ano, Arquivo de origem, …) — valem no servidor web ----
  function relNavegarDims(params) {
    if (window.location.protocol.indexOf('http') === 0 && window.location.pathname.indexOf('/web/') === 0) {
      var qs = params.toString();
      try { if (window.parent && window.parent !== window) {
        window.parent.history.replaceState(null, '', window.parent.location.pathname + (qs ? '?' + qs : '')); } } catch (e) {}
      window.location.search = qs ? '?' + qs : '';
      return true;
    }
    return false;
  }
  function relSemDimensoes() {
    var p; try { p = new URLSearchParams(window.location.search); } catch (e) { p = new URLSearchParams(); }
    var fora = []; p.forEach(function (v, k) { if (k.indexOf('sel:') === 0) fora.push(k); });
    for (var i = 0; i < fora.length; i++) p.delete(fora[i]);
    return p;
  }
  function relPreservarDimensoes(params) {
    var temSel = false; params.forEach(function (v, k) { if (k.indexOf('sel:') === 0) temSel = true; });
    if (temSel) return;
    try { new URLSearchParams(window.location.search).forEach(function (v, k) {
      if (k.indexOf('sel:') === 0 || k === 'modo' || k === 'versao') params.append(k, v); }); } catch (e) {}
  }
  window.relAplicarFiltros = function () {
    var p = relSemDimensoes();
    var cks = document.querySelectorAll('.rel-ck-dim:checked');
    for (var i = 0; i < cks.length; i++) { p.append('sel:' + cks[i].getAttribute('data-dim'), cks[i].value); }
    relNavegarDims(p);
  };
  window.relLimparFiltros = function () { relNavegarDims(relSemDimensoes()); };

  var fb = document.getElementById('rel-filtro-datas');
  if (fb) {
    var col = fb.getAttribute('data-col') || '';
    var minD = fb.getAttribute('data-min') || '';
    var maxD = fb.getAttribute('data-max') || '';
    function navegarServidor(params) {
      if (col) params.set('coluna_data', col);
      relPreservarDimensoes(params);
      var qs = params.toString();
      if (window.location.protocol.indexOf('http') === 0 && window.location.pathname.indexOf('/web/') === 0) {
        try {
          if (window.parent && window.parent !== window) {
            window.parent.history.replaceState(null, '', window.parent.location.pathname + (qs ? '?' + qs : ''));
          }
        } catch (e) {}
        window.location.search = qs ? '?' + qs : '';
        return true;
      }
      return false;
    }
    function filtrarTabelasOffline(rots) {
      var todas = document.querySelectorAll('table');
      var conjunto = rots && rots.length ? {} : null;
      if (conjunto) { for (var i = 0; i < rots.length; i++) conjunto[rots[i]] = true; }
      var reMes = /^(jan|fev|mar|abr|mai|jun|jul|ago|set|out|nov|dez)\/\d{2}$/i;
      for (var t = 0; t < todas.length; t++) {
        var ths = todas[t].querySelectorAll('thead th');
        var temMes = false;
        for (var c = 0; c < ths.length; c++) {
          if (reMes.test(ths[c].textContent.trim())) { temMes = true; break; }
        }
        if (!temMes) continue;
        for (var c2 = 0; c2 < ths.length; c2++) {
          var txt = ths[c2].textContent.trim();
          var esconder = Boolean(conjunto && reMes.test(txt) && !conjunto[txt]);
          ths[c2].style.display = esconder ? 'none' : '';
          var trs = todas[t].querySelectorAll('tbody tr');
          for (var r = 0; r < trs.length; r++) {
            if (trs[r].children[c2]) trs[r].children[c2].style.display = esconder ? 'none' : '';
          }
        }
      }
    }
    window.relAplicarDatas = function () {
      var de = document.getElementById('rel-de').value;
      var ate = document.getElementById('rel-ate').value;
      var p = new URLSearchParams();
      if (de) p.set('de', de);
      if (ate) p.set('ate', ate);
      if (navegarServidor(p)) return;
      if (periodo && de && ate && de.slice(0, 4) === ate.slice(0, 4)) {
        var ano = de.slice(0, 4);
        for (var i = 0; i < periodo.options.length; i++) {
          if (periodo.options[i].text === ano) {
            periodo.value = periodo.options[i].value;
            periodo.dispatchEvent(new Event('change'));
            break;
          }
        }
      }
    };
    window.relFiltrarAno = function (ano) {
      var de = ano + '-01-01', ate = ano + '-12-31';
      if (minD && de < minD) de = minD;
      if (maxD && ate > maxD) ate = maxD;
      document.getElementById('rel-de').value = de;
      document.getElementById('rel-ate').value = ate;
      window.relAplicarDatas();
    };
    window.relMesmoMes = function (mesNum) {
      var cks = document.querySelectorAll('.rel-ck-mes');
      for (var i = 0; i < cks.length; i++) {
        cks[i].checked = (parseInt(cks[i].getAttribute('data-mes'), 10) === mesNum);
      }
      window.relAplicarMeses();
    };
    window.relAplicarMeses = function () {
      var cks = document.querySelectorAll('.rel-ck-mes:checked');
      var yms = [], rots = [];
      for (var i = 0; i < cks.length; i++) {
        yms.push(cks[i].value);
        rots.push(cks[i].getAttribute('data-rot'));
      }
      if (!yms.length) { window.relLimparDatas(); return; }
      var p = new URLSearchParams();
      p.set('meses', yms.join(','));
      if (navegarServidor(p)) return;
      filtrarTabelasOffline(rots);
    };
    window.relLimparDatas = function () {
      document.getElementById('rel-de').value = minD;
      document.getElementById('rel-ate').value = maxD;
      var cks = document.querySelectorAll('.rel-ck-mes');
      for (var i = 0; i < cks.length; i++) cks[i].checked = false;
      if (navegarServidor(new URLSearchParams())) return;
      filtrarTabelasOffline(null);
    };
  }
})();
</script>
</body>
</html>
