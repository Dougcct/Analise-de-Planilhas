<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ a.titulo }} – Relatório</title>
<style>
:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --surface-2: #f2f1ed;
  --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11,11,11,0.10);
  --marca: #00995d; --alerta: #b4521f; --ok: #006300; --atencao: #b8860b;
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100;
  --s5: #7c5cd6; --s6: #d4457a; --s7: #9a998f; --s8: #4aa3b8;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --surface-2: #232321;
    --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,0.10);
    --marca: #2fbf7f; --alerta: #ec835a; --ok: #0ca30c; --atencao: #e0a82e;
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500;
    --s5: #9478e8; --s6: #e0628f; --s7: #6f6e68; --s8: #57b3c8;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --surface-2: #232321;
  --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
  --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,0.10);
  --marca: #2fbf7f; --alerta: #ec835a; --ok: #0ca30c; --atencao: #e0a82e;
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500;
  --s5: #9478e8; --s6: #e0628f; --s7: #6f6e68; --s8: #57b3c8;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink);
  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
.topo { background: var(--surface); border-bottom: 3px solid var(--marca); }
.topo-in, main { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
.topo-in { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: flex-end; justify-content: space-between; padding-top: 20px; padding-bottom: 16px; }
h1 { font-size: 22px; margin: 0; line-height: 1.25; }
.sub { color: var(--ink-2); margin: 2px 0 0; }
.meta { color: var(--muted); font-size: 12px; text-align: right; }
nav.indice { position: sticky; top: 0; z-index: 15; background: var(--surface); border-bottom: 1px solid var(--grid); }
nav.indice div { max-width: 1180px; margin: 0 auto; padding: 6px 16px; display: flex; gap: 4px 14px; flex-wrap: wrap; font-size: 13px; align-items: center; }
nav.indice a { color: var(--ink-2); text-decoration: none; }
nav.indice a:hover { color: var(--ink); text-decoration: underline; }
#periodo-l { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); }
#periodo { background: var(--surface); border: 1px solid var(--border); color: var(--ink); border-radius: 6px; padding: 1px 6px; font: inherit; cursor: pointer; }
#tema, .nav-btn { background: none; border: 1px solid var(--border); color: var(--ink-2); border-radius: 6px; padding: 2px 9px; cursor: pointer; font: inherit; font-size: 12.5px; }
.nav-btn.prim { background: rgba(0,153,93,0.12); border-color: var(--marca); color: var(--marca); font-weight: 600; }
.nav-btn:hover, #tema:hover { border-color: var(--marca); color: var(--ink); }
.f-bar { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--grid); }
.f-row { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: flex-end; }
.f-grp { display: flex; flex-direction: column; gap: 2px; font-size: 12px; color: var(--ink-2); }
.f-grp input[type="date"] { background: var(--surface-2); border: 1px solid var(--border); color: var(--ink); border-radius: 6px; padding: 4px 8px; font: inherit; }
.f-btn { background: var(--marca); color: #fff; border: 1px solid var(--marca); border-radius: 6px; padding: 5px 12px; font: 600 12.5px/1.3 inherit; cursor: pointer; }
.f-btn.sec { background: var(--surface-2); color: var(--ink); border-color: var(--border); font-weight: 500; }
.f-btn:hover { opacity: .9; }
.f-chips { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; margin: 6px 0; }
.f-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-2); font-size: 12px; cursor: pointer; user-select: none; color: var(--ink); }
.f-chip:has(input:checked) { background: rgba(0,153,93,0.16); border-color: var(--marca); font-weight: 600; }
.f-dims { display: flex; flex-wrap: wrap; gap: 8px 14px; }
.f-dim { margin: 0; border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; background: var(--surface-2); min-width: 160px; }
.f-dim > summary { font-weight: 600; font-size: 12.5px; color: var(--ink-2); }
.f-dim[open] { flex-basis: 100%; }
.f-dim .f-chips { margin-top: 8px; max-height: 190px; overflow: auto; }
.f-badge { color: var(--marca); font-size: 10px; vertical-align: 1px; }
.vista[hidden] { display: none; }
section { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; margin: 16px 0; scroll-margin-top: 44px; }
h2 { font-size: 17px; margin: 0 0 2px; }
h3 { font-size: 14px; margin: 18px 0 6px; color: var(--ink-2); }
.desc { color: var(--ink-2); margin: 0 0 14px; font-size: 13px; }
.filtros { display: grid; grid-template-columns: max-content 1fr; gap: 2px 16px; margin: 0; font-size: 13px; }
.filtros dt { color: var(--muted); } .filtros dd { margin: 0; }
.avisos { border-left: 3px solid var(--alerta); padding-left: 10px; color: var(--ink-2); font-size: 13px; margin-top: 10px; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
.kpi { background: var(--surface-2); border-radius: 8px; padding: 12px 14px; }
.kpi .rot { color: var(--ink-2); font-size: 12px; }
.kpi .val { font-size: 22px; font-weight: 600; line-height: 1.25; }
.kpi .val.marca { color: var(--marca); }
.kpi .nota { color: var(--muted); font-size: 11.5px; }
ul.achados { margin: 0; padding-left: 18px; } ul.achados li { margin: 4px 0; position: relative; }
table.metas { width: auto; margin: 4px 0 12px; } table.metas td { border: none; padding: 3px 14px 3px 0; font-size: 13.5px; }
.metas .ok { color: var(--ok); font-weight: 600; } .metas .nok { color: var(--alerta); font-weight: 600; } .metas .atencao { color: var(--atencao); font-weight: 600; } .metas .nd { color: var(--muted); }
.obs { background: var(--surface-2); border-left: 3px solid var(--marca); padding: 8px 12px; border-radius: 0 6px 6px 0; margin: 4px 0 14px; white-space: pre-wrap; }
/* Resumo em destaque (hero) — a parte mais útil do relatório */
section.resumo { border: 1.5px solid var(--marca); box-shadow: 0 0 0 3px rgba(0,153,93,0.07), var(--sombra, 0 1px 2px rgba(0,0,0,.04));
  background: linear-gradient(180deg, rgba(0,153,93,0.06), var(--surface) 130px); }
section.resumo > h2 { font-size: 20px; color: var(--marca); display: flex; align-items: center; gap: 9px; }
section.resumo > h2::before { content: ""; width: 6px; height: 21px; background: var(--marca); border-radius: 3px; }
.desc.lead { font-size: 15px; color: var(--ink); margin: 0 0 16px; }
.kpis-resumo { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
.kpis-resumo .kpi { border: 1px solid var(--border); }
.kpis-resumo .kpi.hero { grid-column: span 2; background: var(--marca); border-color: var(--marca);
  display: flex; flex-direction: column; justify-content: center; }
.kpis-resumo .kpi.hero .rot { color: rgba(255,255,255,0.88); }
.kpis-resumo .kpi.hero .val, .kpis-resumo .kpi.hero .val.marca { color: #fff; font-size: 34px; }
.kpis-resumo .kpi.hero .nota { color: rgba(255,255,255,0.82); }
@media (max-width: 520px) { .kpis-resumo .kpi.hero { grid-column: 1 / -1; } }
/* Medidores de meta (valor × alvo) */
.medidores { display: grid; gap: 13px; margin: 6px 0 14px; }
.med-top { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
.med-rot { color: var(--ink); font-weight: 600; font-size: 13px; }
.med-val { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 14px; }
.med-val.ok { color: var(--ok); } .med-val.nok { color: var(--alerta); } .med-val.atencao { color: var(--atencao); } .med-val.nd { color: var(--muted); }
.med-trilho { position: relative; height: 12px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; margin: 6px 0 4px; }
.med-barra { position: absolute; left: 0; top: 0; height: 100%; border-radius: 999px; min-width: 2px; }
.med-alvo { position: absolute; top: -3px; width: 2px; height: 18px; background: var(--ink); opacity: .7; }
.med-meta { color: var(--muted); font-size: 11.5px; }
/* Achados em cartões */
ul.achados.cartoes { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 8px; }
ul.achados.cartoes li { margin: 0; background: var(--surface-2); border-left: 3px solid var(--marca); border-radius: 0 6px 6px 0; padding: 9px 13px; }
/* ============ Painel executivo (diretoria) — estilo dashboard/Power BI ============ */
section.exec { border: 1.5px solid var(--marca); border-radius: 14px; padding: 0; overflow: hidden;
  box-shadow: 0 0 0 3px rgba(0,153,93,0.06), 0 6px 22px rgba(0,0,0,.06); background: var(--surface); }
.exec-cab { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px;
  padding: 14px 20px; background: linear-gradient(100deg, var(--marca), var(--ok)); color: #fff; }
.exec-cab h2 { font-size: 16px; margin: 0; color: #fff; letter-spacing: .3px; display: flex; align-items: center; gap: 8px; }
.exec-cab h2::before { content: "▦"; opacity: .85; }
.exec-per { font-size: 13px; color: rgba(255,255,255,0.92); font-weight: 600; }
.exec-edit-btn { background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.45);
  border-radius: 7px; padding: 4px 10px; font: 600 12px/1.3 inherit; cursor: pointer; }
.exec-edit-btn:hover { background: rgba(255,255,255,0.28); }
.exec-corpo { padding: 16px 20px 20px; }
.kpis-exec { display: grid; grid-template-columns: repeat(auto-fit, minmax(176px, 1fr)); gap: 12px; }
.kpi-exec { position: relative; background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px;
  padding: 14px 16px 13px; border-top: 3px solid var(--axis); min-width: 0; overflow: hidden;
  box-shadow: 0 1px 2px rgba(0,0,0,.04); transition: transform .12s, box-shadow .12s; }
.kpi-exec:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.09); }
.kpi-exec::after { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: transparent; }
.kpi-exec:nth-child(2) { border-top-color: var(--s1); }
.kpi-exec:nth-child(3) { border-top-color: var(--s3); }
.kpi-exec:nth-child(4) { border-top-color: var(--s4); }
.kpi-exec:nth-child(5) { border-top-color: var(--s5); }
.kpi-exec:nth-child(6) { border-top-color: var(--s2); }
.kpi-exec:nth-child(7) { border-top-color: var(--s6); }
.kpi-exec.destaque { border-top-color: var(--marca); background:
  linear-gradient(160deg, rgba(0,153,93,0.14), var(--surface-2) 72%); grid-column: span 2; }
.kpi-exec .rot { color: var(--ink-2); font-size: 11.5px; text-transform: uppercase; letter-spacing: .4px;
  font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kpi-exec .val { font-size: 28px; font-weight: 700; line-height: 1.12; margin-top: 4px; font-variant-numeric: tabular-nums; }
.kpi-exec.destaque .val { font-size: 36px; color: var(--marca); }
.kpi-exec .nota { color: var(--muted); font-size: 11.5px; margin-top: 3px; }
@media (max-width: 560px) { .kpi-exec.destaque { grid-column: 1 / -1; } }
/* Editor do Painel Executivo */
.exec-cfg { background: var(--surface-2); border: 1.5px dashed var(--marca); border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; }
.exec-cfg h4 { margin: 0 0 8px; font-size: 13.5px; color: var(--marca); }
.exec-cfg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
.exec-cfg-lista { display: flex; flex-direction: column; gap: 5px; max-height: 240px; overflow: auto; padding-right: 4px; }
.exec-cfg-item { display: flex; align-items: center; gap: 6px; background: var(--surface); border: 1px solid var(--border);
  border-radius: 7px; padding: 5px 8px; font-size: 12.5px; }
.exec-cfg-item label { flex: 1; display: flex; align-items: center; gap: 6px; cursor: pointer; min-width: 0; }
.exec-cfg-item label span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exec-cfg-mini { background: var(--surface-2); border: 1px solid var(--border); color: var(--ink-2); border-radius: 5px;
  padding: 1px 6px; font-size: 11px; cursor: pointer; }
.exec-cfg-mini.ativo { background: var(--marca); color: #fff; border-color: var(--marca); }
/* badge de variação vs período anterior */
.delta { display: inline-flex; align-items: center; gap: 3px; font-size: 12px; font-weight: 700; margin-top: 7px;
  padding: 2px 8px; border-radius: 999px; font-variant-numeric: tabular-nums; width: fit-content; }
.delta .seta { font-size: 10px; line-height: 1; }
.delta.bom { color: var(--ok); background: rgba(0,99,0,0.12); }
.delta.ruim { color: var(--alerta); background: rgba(180,82,31,0.14); }
.delta.neutro { color: var(--ink-2); background: var(--surface); border: 1px solid var(--border); }
.delta-vs { color: var(--muted); font-size: 10.5px; font-weight: 500; margin-left: 6px; }
.exec-graficos { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
.exec-fig { position: relative; grid-column: span 6; min-width: 0; background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
.exec-fig[data-larg="3"] { grid-column: span 3; }
.exec-fig[data-larg="4"] { grid-column: span 4; }
.exec-fig[data-larg="6"] { grid-column: span 6; }
.exec-fig[data-larg="8"] { grid-column: span 8; }
.exec-fig[data-larg="12"] { grid-column: 1 / -1; }
.exec-fig h3 { margin: 0 0 12px; color: var(--ink); font-size: 13.5px; }
/* Tamanho do Painel Executivo e Largura da Página */
body[data-largura="largo"] .topo-in, body[data-largura="largo"] main, body[data-largura="largo"] nav.indice div, body[data-largura="largo"] .ed-topo { max-width: 1480px; }
body[data-largura="fluido"] .topo-in, body[data-largura="fluido"] main, body[data-largura="fluido"] nav.indice div, body[data-largura="fluido"] .ed-topo { max-width: 98vw; }
section.exec[data-tam="compacto"] .exec-cab { padding: 9px 16px; }
section.exec[data-tam="compacto"] .exec-corpo { padding: 12px 14px 14px; }
section.exec[data-tam="compacto"] .kpi-exec { padding: 9px 12px; }
section.exec[data-tam="compacto"] .kpi-exec .val { font-size: 21px; }
section.exec[data-tam="compacto"] .kpi-exec.destaque .val { font-size: 26px; }
section.exec[data-tam="expandido"] .exec-cab { padding: 18px 24px; }
section.exec[data-tam="expandido"] .exec-cab h2 { font-size: 19px; }
section.exec[data-tam="expandido"] .exec-corpo { padding: 22px 24px 26px; }
section.exec[data-tam="expandido"] .kpi-exec { padding: 18px 20px; }
section.exec[data-tam="expandido"] .kpi-exec .val { font-size: 34px; }
section.exec[data-tam="expandido"] .kpi-exec.destaque .val { font-size: 44px; }
.kpi-exec[data-span="1"] { grid-column: span 1; }
.kpi-exec[data-span="2"] { grid-column: span 2; }
.kpi-exec[data-span="3"] { grid-column: span 3; }
.kpi-exec .ed-kpi-bar { display: none; gap: 3px; margin-bottom: 6px; }
body.modo-editavel .kpi-exec .ed-kpi-bar { display: flex; }
/* ============ Comparativo entre períodos ============ */
section.comparar .cmp-sel { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: flex-end; margin: 4px 0 14px; }
.cmp-grp { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--ink-2); }
.cmp-grp select { background: var(--surface-2); border: 1px solid var(--border); color: var(--ink); border-radius: 8px;
  padding: 6px 10px; font: inherit; min-width: 150px; }
.cmp-swap { background: var(--surface-2); border: 1px solid var(--border); color: var(--ink-2); border-radius: 8px;
  padding: 7px 11px; cursor: pointer; font: inherit; }
table.cmp td.delta-cell { font-weight: 700; font-variant-numeric: tabular-nums; }
table.cmp .bom { color: var(--ok); } table.cmp .ruim { color: var(--alerta); } table.cmp .neutro { color: var(--ink-2); }
table.cmp .seta { font-size: 10px; }
.legenda { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--ink-2); margin: 4px 0 6px; }
.leg-item i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
svg.grafico { width: 100%; height: auto; display: block; }
svg .grade { stroke: var(--grid); stroke-width: 1; } svg .base { stroke: var(--axis); stroke-width: 1; }
svg .eixo { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
svg .valor { fill: var(--ink-2); font-size: 11px; font-weight: 600; }
svg [data-tip]:hover { opacity: .82; }
.barras { display: grid; gap: 8px; }
.barra-linha { display: grid; grid-template-columns: minmax(110px, 32%) 1fr auto; gap: 12px; align-items: center; padding: 1px 0; }
.barra-rot { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--ink); }
.barra-trilho { background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; height: 16px; overflow: hidden; }
.barra { display: block; height: 100%; min-width: 3px; border-radius: 999px;
  background: linear-gradient(90deg, rgba(255,255,255,0.20), rgba(255,255,255,0) 42%), var(--cor); }
.barra-val { font-size: 12.5px; font-weight: 600; color: var(--ink); white-space: nowrap; font-variant-numeric: tabular-nums; }
/* Rosca (donut) + legenda */
.rosca-wrap { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.rosca-svg { width: 148px; height: 148px; flex: none; }
.rosca-svg circle { transition: opacity .1s; } .rosca-svg circle:hover { opacity: .8; }
.rz-num { fill: var(--ink); font-size: 21px; font-weight: 700; font-variant-numeric: tabular-nums; }
.rz-rot { fill: var(--muted); font-size: 8px; text-transform: uppercase; letter-spacing: .4px; }
.rosca-leg { list-style: none; margin: 0; padding: 0; flex: 1; min-width: 190px; display: grid; gap: 7px; }
.rosca-leg li { display: grid; grid-template-columns: 12px 1fr auto auto; align-items: center; gap: 9px; font-size: 12.5px; }
.rosca-leg i { width: 11px; height: 11px; border-radius: 3px; }
.rz-nome { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--ink); }
.rosca-leg b { font-variant-numeric: tabular-nums; color: var(--ink); }
.rz-pct { color: var(--muted); font-variant-numeric: tabular-nums; min-width: 44px; text-align: right; }
.tabela-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 12.5px; }
th, td { text-align: left; padding: 5px 8px; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--ink-2); font-weight: 600; background: var(--surface-2); position: sticky; top: 0; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
td.barra { position: relative; }
td.barra > span { position: relative; z-index: 1; }
td.barra::before { content: ""; position: absolute; left: 4px; top: 50%; transform: translateY(-50%);
  height: 62%; width: var(--w, 0%); max-width: calc(100% - 8px); background: var(--s1); opacity: 0.16;
  border-radius: 3px; z-index: 0; }
tbody tr:hover { background: var(--surface-2); }
@media print { td.barra::before { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
.baixar-dados { display: inline-block; margin-left: 8px; font-size: 12.5px; font-weight: 600;
  color: var(--marca); text-decoration: none; border: 1px solid var(--border); border-radius: 8px; padding: 2px 10px; }
.baixar-dados:hover { background: var(--surface-2); }
details { margin-top: 10px; } summary { cursor: pointer; color: var(--ink-2); font-size: 13px; }
details .tabela-wrap { max-height: 480px; overflow: auto; margin-top: 8px; }
.grade-paineis { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 10px 24px; }
.painel { position: relative; grid-column: 1 / -1; min-width: 0; }
.painel.meia, .painel[data-larg="6"] { grid-column: span 6; }
.painel[data-larg="3"] { grid-column: span 3; }
.painel[data-larg="4"] { grid-column: span 4; }
.painel[data-larg="8"] { grid-column: span 8; }
.painel[data-larg="12"] { grid-column: 1 / -1; }
.painel-fig-wrap svg.grafico, .exec-fig svg.grafico { transition: height .15s; }
/* Modal Construtor de Novo Gráfico */
#modal-novo-grafico { position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,0.52); display: none; align-items: center; justify-content: center; padding: 16px; }
#modal-novo-grafico.aberto { display: flex; }
.mng-caixa { background: var(--surface); border: 1.5px solid var(--marca); border-radius: 14px; width: min(680px, 96vw); max-height: 92vh; overflow: auto; padding: 18px 22px; box-shadow: 0 16px 40px rgba(0,0,0,0.28); }
.mng-caixa h3 { margin: 0 0 10px; color: var(--marca); font-size: 16px; }
.mng-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-bottom: 12px; }
.mng-campo { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--ink-2); }
.mng-campo input, .mng-campo select, .mng-campo textarea { background: var(--surface-2); border: 1px solid var(--border); color: var(--ink); border-radius: 7px; padding: 6px 9px; font: inherit; }
.kpis.mini { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; margin: 4px 0 10px; }
.kpis.mini .kpi { padding: 8px 10px; } .kpis.mini .val { font-size: 18px; }
.painel .aberta { max-height: 520px; overflow: auto; }
@media (max-width: 860px) { .painel.meia { grid-column: 1 / -1; } }
ul.alertas { margin: 0; padding-left: 18px; font-size: 13px; } ul.alertas li { margin: 3px 0; }
.al-erro { color: var(--alerta); font-weight: 600; } .al-aviso { color: var(--alerta); } .al-info { color: var(--ink-2); }
.vazio { color: var(--muted); font-style: italic; }
#tip { position: fixed; pointer-events: none; z-index: 20; background: var(--ink); color: var(--surface); font-size: 12px;
  padding: 5px 8px; border-radius: 6px; max-width: 320px; opacity: 0; transition: opacity .08s; }
footer { color: var(--muted); font-size: 12px; text-align: center; padding: 12px 16px 32px; }

/* ============ MODO VERSÃO EDITÁVEL (2ª versão p/ edição, impressão e compartilhamento) ============ */
[data-oculto="1"] { display: none !important; }
#barra-editavel { display: none; position: sticky; top: 37px; z-index: 14; background: var(--surface);
  border-bottom: 2px solid var(--marca); box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
body.modo-editavel #barra-editavel { display: block; }
.ed-topo { max-width: 1180px; margin: 0 auto; padding: 8px 16px; display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; }
.ed-status { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--ink-2); }
.ed-pilula { background: var(--marca); color: #fff; font-weight: 700; font-size: 11.5px; padding: 2px 9px; border-radius: 999px; }
.ed-acoes { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.ed-ctl { display: none; }
body.modo-editavel .ed-ctl { display: inline-flex; }
.ed-sec-bar { display: none; position: absolute; top: 10px; right: 14px; z-index: 4; gap: 4px; align-items: center;
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 3px 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.06); }
section.exec .ed-sec-bar { top: 10px; right: 16px; background: rgba(0,0,0,0.28); border-color: rgba(255,255,255,0.35); }
section.exec .ed-sec-bar button { color: #fff; border-color: rgba(255,255,255,0.3); background: transparent; }
body.modo-editavel .ed-sec-bar { display: inline-flex; }
.ed-painel-bar { display: none; gap: 4px; flex-wrap: wrap; align-items: center; margin: 6px 0 6px;
  padding: 4px 8px; background: var(--surface-2); border: 1px dashed var(--border); border-radius: 7px; font-size: 11.5px; }
body.modo-editavel .ed-painel-bar { display: flex; }
.ed-mini-btn { background: var(--surface); border: 1px solid var(--border); color: var(--ink-2); border-radius: 5px;
  padding: 2px 7px; font: 500 11.5px/1.3 inherit; cursor: pointer; }
.ed-mini-btn:hover { border-color: var(--marca); color: var(--ink); }
.ed-mini-btn.perigo:hover { border-color: var(--alerta); color: var(--alerta); }
body.modo-editavel [data-editavel="1"] { outline: 1px dashed transparent; border-radius: 4px; transition: outline-color .12s, background .12s; cursor: text; }
body.modo-editavel [data-editavel="1"]:hover, body.modo-editavel [data-editavel="1"]:focus {
  outline-color: var(--marca); background: rgba(0,153,93,0.05); }
.ed-achado-del { display: none; float: right; margin-left: 8px; background: none; border: none; color: var(--muted); cursor: pointer; font-size: 13px; line-height: 1; }
.ed-achado-del:hover { color: var(--alerta); }
body.modo-editavel .ed-achado-del { display: inline; }
.ed-gaveta { display: none; max-width: 1180px; margin: 0 auto; padding: 8px 16px 12px; border-top: 1px solid var(--grid); background: var(--surface-2); font-size: 12.5px; }
.ed-gaveta.aberta { display: block; }
.ed-msg { font-size: 12px; font-weight: 600; color: var(--marca); }

@media (max-width: 600px) {
  .meta { text-align: left; }
  .barra-linha { grid-template-columns: minmax(74px, 38%) 1fr auto; gap: 8px; }
  section { padding: 14px 14px; }
}
@media print {
  nav.indice, #barra-editavel, .ed-sec-bar, .ed-painel-bar, .ed-ctl, .ed-achado-del, .exec-edit-btn, .exec-cfg, .no-print, #tip, #tema { display: none !important; }
  [data-oculto="1"] { display: none !important; }
  body { background: #fff; color: #000; }
  section { break-inside: avoid; border-color: #ddd; box-shadow: none !important; }
  .painel .aberta, details .tabela-wrap { max-height: none !important; overflow: visible !important; }
  details { display: block; } details > * { display: block; }
}
</style>
</head>
<body class="{{ 'modo-editavel' if a.modo_editavel }}" data-largura="{{ a.largura_pagina or 'padrao' }}">
{%- macro tabela(colunas, linhas) -%}
<div class="tabela-wrap"><table>
  <thead><tr>{% for col in colunas %}<th class="{{ 'n' if col[2] }}">{{ col[0] }}</th>{% endfor %}</tr></thead>
  <tbody>{% for linha in linhas %}<tr>{% for col in colunas %}
    {%- if col[3] and (col[1] ~ '_b') in linha -%}
      <td class="n barra" style="--w:{{ linha[col[1] ~ '_b'] }}%"><span>{{ linha.get(col[1], '') }}</span></td>
    {%- else -%}
      <td class="{{ 'n' if col[2] }}">{{ linha.get(col[1], '') }}</td>
    {%- endif -%}
  {% endfor %}</tr>{% endfor %}</tbody>
</table></div>
{%- endmacro %}
<header class="topo"><div class="topo-in">
  <div>
    <h1 id="rel-titulo-h1" data-editavel="1">{{ a.titulo }}</h1>
    <p class="sub" id="rel-sub-p" data-editavel="1">{% if a.sub %}{{ a.sub }}{% else %}Relatório analítico{% if a.periodo %} · {{ a.periodo }}{% endif %}{% endif %}</p>
  </div>
  <div class="meta">Gerado em {{ a.gerado_em }} · v{{ a.versao }}<br>{{ a.arquivos|length }} arquivo(s)</div>
</div></header>

<nav class="indice no-print"><div>
  <a data-sec="filtros" href="#filtros-v0">Filtros</a><a data-sec="exec" href="#exec-v0">Painel</a><a data-sec="resumo" href="#resumo-v0">Resumo e achados</a>
  {% for s in a.vistas[0].secoes %}<a data-sec="{{ s.id }}" href="#{{ s.id }}-v0">{{ s.titulo }}</a>{% endfor %}
  {% if a.multi and not a.ocultar_comparar %}<a href="#comparar">Comparar</a>{% endif %}
  {% if not a.ocultar_leitura %}<a href="#leitura">Leitura e qualidade</a>{% endif %}
  {% if a.base and not a.ocultar_base %}<a href="#base">Base detalhada</a>{% endif %}
  {% if not a.ocultar_metodologia %}<a href="#metodologia">Metodologia</a>{% endif %}
  {% if a.multi %}<label id="periodo-l" title="Troca a vista do relatório (recalculada no Python, embutida)">{{ 'Período' if a.datas_info else 'Ver' }}
    <select id="periodo">{% for v in a.vistas %}<option value="{{ loop.index0 }}">{{ v.rotulo }}</option>{% endfor %}</select></label>{% endif %}
  {% if not a.somente_editada %}
  <button id="btn-gerar-editavel" class="nav-btn prim" type="button" onclick="edAtivarModo()" title="Cria uma versão editável deste relatório para customizar, imprimir ou compartilhar">{{ '✎ Editar versão' if a.modo_editavel else '✦ Gerar versão editável' }}</button>
  {% endif %}
  <button class="nav-btn" type="button" onclick="window.print()" title="Imprimir ou salvar como PDF">🖨 Imprimir</button>
  <button id="tema" type="button" aria-label="Alternar tema">◐ tema</button>
</div></nav>

<div id="barra-editavel" class="no-print">
  <div class="ed-topo">
    <div class="ed-status">
      <span class="ed-pilula">✦ Versão Editável</span>
      <span>Clique em qualquer título ou texto para editar · Reordene, ajuste largura (50%/100%) ou oculte o que não precisa antes de imprimir ou compartilhar.</span>
      <span id="ed-feedback" class="ed-msg"></span>
    </div>
    <div class="ed-acoes">
      <button type="button" class="f-btn sec" onclick="edAbrirModalGrafico('exec')">📊 + Novo gráfico</button>
      <button type="button" class="f-btn sec" onclick="edAdicionarBlocoTexto()">+ Bloco de texto</button>
      <button type="button" class="f-btn sec" onclick="edAdicionarAchado()">+ Achado / nota</button>
      <label class="ed-mini-btn" style="display:inline-flex;align-items:center;gap:4px">Executivo:
        <select id="ed-sel-tam-exec" onchange="edMudarTamExec(this.value)" style="border:none;background:transparent;color:inherit;font:inherit;cursor:pointer">
          <option value="compacto" {{ 'selected' if a.vistas[0].tam_exec == 'compacto' }}>Compacto</option>
          <option value="padrao" {{ 'selected' if (a.vistas[0].tam_exec or 'padrao') == 'padrao' }}>Padrão</option>
          <option value="expandido" {{ 'selected' if a.vistas[0].tam_exec == 'expandido' }}>Expandido</option>
        </select>
      </label>
      <label class="ed-mini-btn" style="display:inline-flex;align-items:center;gap:4px">Página:
        <select id="ed-sel-larg-pag" onchange="edMudarLarguraPagina(this.value)" style="border:none;background:transparent;color:inherit;font:inherit;cursor:pointer">
          <option value="padrao" {{ 'selected' if (a.largura_pagina or 'padrao') == 'padrao' }}>Normal</option>
          <option value="largo" {{ 'selected' if a.largura_pagina == 'largo' }}>Largo (1480px)</option>
          <option value="fluido" {{ 'selected' if a.largura_pagina == 'fluido' }}>Tela toda</option>
        </select>
      </label>
      <button type="button" class="f-btn sec" onclick="edToggleGavetaOcultos()">👁 Ocultos (<span id="ed-n-ocultos">0</span>)</button>
      <button type="button" class="f-btn sec" onclick="window.print()">🖨 Imprimir / PDF</button>
      <button type="button" class="f-btn sec" onclick="edBaixarHtml()">⬇ Baixar HTML editado</button>
      {% if a.pode_editar and a.slug %}
      <button type="button" class="f-btn" onclick="edSalvarNoServidor()">💾 Salvar versão p/ compartilhar</button>
      {% endif %}
      <button type="button" class="f-btn sec" onclick="edSairModo()">Concluir edição</button>
    </div>
  </div>
  <div id="ed-gaveta-ocultos" class="ed-gaveta">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <b>Itens removidos desta versão (clique para restaurar):</b>
      <button type="button" class="ed-mini-btn" onclick="edRestaurarTudo()">Restaurar tudo</button>
    </div>
    <div id="ed-lista-ocultos" class="f-chips"></div>
  </div>
</div>

<main id="rel-main">
{% for v in a.vistas %}
<div class="vista" data-i="{{ v.i }}"{{ ' hidden' if not loop.first }}>

{% if not a.ocultar_filtros or a.modo_editavel %}
<section id="filtros-v{{ v.i }}" data-sec-id="filtros" data-sec-nome="Filtros aplicados" data-oculto="{{ '1' if a.ocultar_filtros else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover seção para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover seção para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('filtros', 'Filtros aplicados')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">Filtros aplicados</h2>
  <dl class="filtros">{% for rot, val in v.filtros %}<dt>{{ rot }}</dt><dd>{{ val }}</dd>{% endfor %}
    <dt>Fonte</dt><dd>{{ v.arquivos|join(', ') if v.arquivos else '—' }}</dd></dl>
  {% if v.avisos %}<div class="avisos">{% for av in v.avisos %}<div>{{ av }}</div>{% endfor %}</div>{% endif %}
  {% if loop.first and a.datas_info %}
  <div class="f-bar no-print" id="rel-filtro-datas" data-col="{{ a.datas_info.coluna }}" data-min="{{ a.datas_info.min_data }}" data-max="{{ a.datas_info.max_data }}">
    <div class="f-row">
      <div class="f-grp"><label>De</label><input type="date" id="rel-de" value="{{ a.datas_info.de }}" min="{{ a.datas_info.min_data }}" max="{{ a.datas_info.max_data }}"></div>
      <div class="f-grp"><label>Até</label><input type="date" id="rel-ate" value="{{ a.datas_info.ate }}" min="{{ a.datas_info.min_data }}" max="{{ a.datas_info.max_data }}"></div>
      <button type="button" class="f-btn" onclick="relAplicarDatas()">Filtrar datas</button>
      <button type="button" class="f-btn sec" onclick="relLimparDatas()">Todo o período</button>
      {% if a.datas_info.anos|length > 1 %}
      <div class="f-chips" style="margin-left:auto">
        <span style="font-size:12px;color:var(--muted)">Ano:</span>
        {% for ano in a.datas_info.anos %}<button type="button" class="f-btn sec" style="padding:3px 9px;border-radius:999px" onclick="relFiltrarAno({{ ano }})">{{ ano }}</button>{% endfor %}
      </div>
      {% endif %}
    </div>
    <details style="margin-top:8px" {{ 'open' if a.datas_info.tem_meses or a.datas_info.anos|length > 1 }}>
      <summary style="font-weight:600;color:var(--marca)">Comparar meses específicos (ex.: comparar um mês de 2024 com 2025 ou 2026)</summary>
      {% if a.datas_info.anos|length > 1 %}
      <div class="f-chips" style="margin-top:8px">
        <span style="font-size:12px;color:var(--muted)">Mesmo mês em todos os anos:</span>
        {% for m in a.datas_info.meses_nomes %}<button type="button" class="f-btn sec" style="padding:2px 8px;border-radius:999px;font-size:11.5px" onclick="relMesmoMes({{ m.num }})">{{ m.abrev }}</button>{% endfor %}
      </div>
      {% endif %}
      <div style="margin:6px 0">
        {% for ano, itens in a.datas_info.meses_por_ano %}
        <div class="f-chips">
          <b style="min-width:38px;font-size:12px;color:var(--ink-2)">{{ ano }}</b>
          {% for it in itens %}
          <label class="f-chip"><input type="checkbox" class="rel-ck-mes" value="{{ it.ym }}" data-rot="{{ it.rotulo }}" data-mes="{{ it.mes }}" {{ 'checked' if it.sel }}> {{ it.rotulo }}</label>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      <div class="f-row" style="margin-top:6px">
        <button type="button" class="f-btn" onclick="relAplicarMeses()">Comparar meses marcados</button>
        <button type="button" class="f-btn sec" onclick="relLimparDatas()">Limpar meses</button>
      </div>
    </details>
  </div>
  {% endif %}
  {% if loop.first and a.filtros_info %}
  <div class="f-bar no-print" id="rel-filtro-dims">
    <div class="f-dims">
    {% for d in a.filtros_info %}
      <details class="f-dim"{{ ' open' if d.ativo or d.arquivo }}>
        <summary>{% if d.arquivo %}Planilha (arquivo){% else %}{{ d.nome }}{% endif %}{% if d.ativo %} <span class="f-badge">●</span>{% endif %}</summary>
        {% if d.arquivo %}<p class="desc" style="margin:2px 0 6px">Escolha uma planilha, várias, ou deixe tudo desmarcado para somar todas.</p>{% endif %}
        <div class="f-chips">
        {% for it in d.valores %}
          <label class="f-chip"><input type="checkbox" class="rel-ck-dim" data-dim="{{ d.nome }}" value="{{ it.v }}" {{ 'checked' if it.sel }}> {{ it.v }}</label>
        {% endfor %}
        </div>
        {% if d.cortado %}<p class="desc" style="margin:4px 0 0">Mostrando os {{ d.valores|length }} mais frequentes de {{ d.n_total }}.</p>{% endif %}
      </details>
    {% endfor %}
    </div>
    <div class="f-row" style="margin-top:8px">
      <button type="button" class="f-btn" onclick="relAplicarFiltros()">Aplicar filtros</button>
      <button type="button" class="f-btn sec" onclick="relLimparFiltros()">Limpar filtros</button>
    </div>
  </div>
  {% endif %}
</section>
{% endif %}

{% if v.total == 0 %}
<section><h2>Sem dados</h2><p class="vazio">Nenhum registro neste período.</p></section>
{% else %}

{% if not a.ocultar_exec or a.modo_editavel %}
<section id="exec-v{{ v.i }}" class="exec" data-sec-id="exec" data-sec-nome="Painel executivo" data-tam="{{ v.tam_exec or 'padrao' }}" data-altura="{{ v.altura_exec or 0 }}" {% if v.altura_exec %}style="min-height:{{ v.altura_exec }}px"{% endif %} data-oculto="{{ '1' if a.ocultar_exec else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edAbrirModalGrafico('exec')" title="Criar novo gráfico no Painel Executivo">+ Gráfico</button>
    <button type="button" class="ed-mini-btn" onclick="edCiclarTamExec()" title="Alternar tamanho do Painel Executivo (Compacto / Padrão / Expandido)">⇕ Tamanho</button>
    <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaExec(-40)" title="Diminuir altura mínima do Painel Executivo">Alt −</button>
    <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaExec(40)" title="Aumentar altura mínima do Painel Executivo">Alt +</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('exec', 'Painel executivo')">✕ Ocultar painel</button>
  </div>
  <div class="exec-cab">
    <h2 id="exec-titulo-v{{ v.i }}" data-editavel="1">{{ v.titulo_exec or 'Painel executivo' }}</h2>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <span class="exec-per">{{ v.rotulo or a.periodo or 'Todo o período' }} · {{ v.total }} registro(s){% if v.rotulo_ant %} · comparado a {{ v.rotulo_ant }}{% endif %}</span>
      {% if (a.pode_editar or a.modo_editavel) and not a.somente_editada and loop.first %}
      <button type="button" class="exec-edit-btn no-print" onclick="edAbrirModalGrafico('exec')">+ Novo gráfico</button>
      <button type="button" class="exec-edit-btn no-print" onclick="execToggleCfg()">⚙ Personalizar Painel Executivo</button>
      {% endif %}
    </div>
  </div>
  <div class="exec-corpo">
    {% if loop.first %}
    <div id="exec-cfg-box" class="exec-cfg no-print" hidden>
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:10px">
        <div>
          <h4>Personalizar Painel Executivo (Gestor / ADM)</h4>
          <p class="desc" style="margin:0">Escolha KPIs, gráficos, tamanho do painel e larguras. Os dados continuam vindo automaticamente da planilha.</p>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
          <label class="ed-mini-btn">Densidade:
            <select id="exec-cfg-tam" onchange="edMudarTamExec(this.value)" style="border:none;background:transparent;color:inherit;font:inherit">
              <option value="compacto" {{ 'selected' if v.tam_exec == 'compacto' }}>Compacto</option>
              <option value="padrao" {{ 'selected' if (v.tam_exec or 'padrao') == 'padrao' }}>Padrão</option>
              <option value="expandido" {{ 'selected' if v.tam_exec == 'expandido' }}>Expandido</option>
            </select>
          </label>
          <button type="button" class="f-btn sec" onclick="edAbrirModalGrafico('exec')">📊 + Criar gráfico</button>
          {% if a.pode_editar and a.slug %}
          <button type="button" class="f-btn" onclick="execSalvarServidor()">Salvar como padrão do relatório</button>
          {% endif %}
          <button type="button" class="f-btn sec" onclick="execRestaurarPadrao()">Padrão automático</button>
          <button type="button" class="f-btn sec" onclick="execToggleCfg()">Fechar</button>
        </div>
      </div>
      <div class="exec-cfg-grid">
        <div>
          <b style="font-size:12.5px;display:block;margin-bottom:6px">1. Indicadores (KPIs) visíveis e Destaque (★):</b>
          <div id="exec-cfg-kpis" class="exec-cfg-lista">
            {% for ck in v.catalogo_kpis %}
            {% set vis = ck.chave in (v.kpis|rejectattr('oculto')|map(attribute='chave')|list) %}
            {% set eh_dest = ck.chave in (v.kpis|selectattr('destaque')|map(attribute='chave')|list) %}
            <div class="exec-cfg-item" data-chave="{{ ck.chave }}">
              <label><input type="checkbox" class="exec-ck-kpi" value="{{ ck.chave }}" {{ 'checked' if vis }} onchange="execAplicarLocal()">
                <span>{{ ck.rotulo }} <small style="color:var(--muted)">({{ ck.valor }})</small></span></label>
              <button type="button" class="exec-cfg-mini {{ 'ativo' if eh_dest }}" onclick="execMarcarDestaque('{{ ck.chave }}')" title="Destacar como KPI principal (Hero)">★</button>
              <button type="button" class="exec-cfg-mini" onclick="execMoverItem(this, -1)" title="Subir">↑</button>
              <button type="button" class="exec-cfg-mini" onclick="execMoverItem(this, 1)" title="Descer">↓</button>
            </div>
            {% endfor %}
          </div>
        </div>
        <div>
          <b style="font-size:12.5px;display:block;margin-bottom:6px">2. Gráficos promovidos ao Painel Executivo:</b>
          <div id="exec-cfg-graficos" class="exec-cfg-lista">
            {% set ids_dest = v.destaques|map(attribute='id')|list %}
            {% for cg in v.catalogo_graficos %}
            <div class="exec-cfg-item" data-gid="{{ cg.id }}">
              <label><input type="checkbox" class="exec-ck-graf" value="{{ cg.id }}" {{ 'checked' if cg.id in ids_dest }} onchange="execAplicarLocal()">
                <span><b>{{ cg.secao }}:</b> {{ cg.titulo }}</span></label>
              <button type="button" class="exec-cfg-mini" onclick="execMoverItem(this, -1)" title="Subir">↑</button>
              <button type="button" class="exec-cfg-mini" onclick="execMoverItem(this, 1)" title="Descer">↓</button>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <span id="exec-cfg-msg" class="ed-msg" style="display:block;margin-top:8px"></span>
    </div>
    {% endif %}

    <div class="kpis-exec" id="kpis-exec-v{{ v.i }}">
      {% for k in v.kpis %}
      <div class="kpi-exec{{ ' destaque' if k.destaque }}" data-chave="{{ k.chave }}" data-span="{{ k.largura or (2 if k.destaque else 1) }}" data-oculto="{{ '1' if k.oculto else '0' }}">
        <div class="ed-kpi-bar no-print">
          <button type="button" class="ed-mini-btn" onclick="edMoverKpiExec(this, -1)" title="Mover KPI para esquerda">←</button>
          <button type="button" class="ed-mini-btn" onclick="edMoverKpiExec(this, 1)" title="Mover KPI para direita">→</button>
          <button type="button" class="ed-mini-btn" onclick="edCiclarSpanKpi(this)" title="Alternar tamanho do cartão KPI (1x / 2x ★ / 3x)">◫ 1x/2x/3x</button>
          <button type="button" class="ed-mini-btn perigo" style="margin-left:auto" onclick="edOcultarKpiExec(this)" title="Ocultar este KPI">✕</button>
        </div>
        <div class="rot" data-editavel="1">{{ k.rotulo }}</div>
        <div class="val">{{ k.valor }}</div>
        {% if k.delta %}<div><span class="delta {{ k.delta.classe }}"><span class="seta">{{ '▲' if k.delta.dir == 'up' else ('▼' if k.delta.dir == 'down' else '▬') }}</span>{{ k.delta.pct }}</span>{% if v.rotulo_ant %}<span class="delta-vs">vs {{ v.rotulo_ant }}</span>{% endif %}</div>{% endif %}
        {% if k.nota %}<div class="nota">{{ k.nota }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if v.metas and v.mostrar_metas_exec %}
    {% set med = g.medidor(v.metas) %}
    {% if med %}<div id="exec-metas-v{{ v.i }}"><h3>Metas do gestor</h3>{{ med }}</div>{% endif %}
    {% endif %}
    <div class="exec-graficos" id="exec-graficos-v{{ v.i }}" {{ 'hidden' if not v.destaques }}>
      {% for d in v.destaques %}
      <div class="exec-fig" data-gid="{{ d.id }}" data-larg="{{ d.largura or 6 }}" data-altura="{{ d.altura or 0 }}" data-custom="{{ '1' if d.custom else '0' }}">
        <div class="ed-painel-bar no-print">
          <button type="button" class="ed-mini-btn" onclick="edMoverGrafExec(this, -1)" title="Mover gráfico para trás">←</button>
          <button type="button" class="ed-mini-btn" onclick="edMoverGrafExec(this, 1)" title="Mover gráfico para frente">→</button>
          <select class="ed-mini-btn ed-sel-larg" onchange="edDefinirLarguraCard(this, this.value)" title="Largura do gráfico">
            <option value="3" {{ 'selected' if d.largura == 3 }}>25%</option>
            <option value="4" {{ 'selected' if d.largura == 4 }}>33%</option>
            <option value="6" {{ 'selected' if (d.largura or 6) == 6 }}>50%</option>
            <option value="8" {{ 'selected' if d.largura == 8 }}>66%</option>
            <option value="12" {{ 'selected' if d.largura == 12 }}>100%</option>
          </select>
          <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaGrafico(this, -35)" title="Diminuir altura do gráfico">Alt −</button>
          <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaGrafico(this, 35)" title="Aumentar altura do gráfico">Alt +</button>
          <button type="button" class="ed-mini-btn perigo" style="margin-left:auto" onclick="edRemoverGrafExec(this)" title="Remover do Painel Executivo">✕</button>
        </div>
        <h3 data-editavel="1">{{ d.titulo }}</h3>
        <div class="exec-fig-corpo" {% if d.altura %}style="min-height:{{ d.altura }}px"{% endif %}>{{ d.figura }}</div>
      </div>
      {% endfor %}
    </div>
    {% if loop.first %}
    <template id="exec-catalogo-graficos-tpl">
      {% for cg in v.catalogo_graficos %}
      <div class="exec-fig" data-gid="{{ cg.id }}" data-titulo="{{ cg.titulo }}" data-larg="6" data-altura="0" data-custom="0">
        <div class="ed-painel-bar no-print">
          <button type="button" class="ed-mini-btn" onclick="edMoverGrafExec(this, -1)" title="Mover gráfico para trás">←</button>
          <button type="button" class="ed-mini-btn" onclick="edMoverGrafExec(this, 1)" title="Mover gráfico para frente">→</button>
          <select class="ed-mini-btn ed-sel-larg" onchange="edDefinirLarguraCard(this, this.value)" title="Largura do gráfico">
            <option value="3">25%</option>
            <option value="4">33%</option>
            <option value="6" selected>50%</option>
            <option value="8">66%</option>
            <option value="12">100%</option>
          </select>
          <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaGrafico(this, -35)" title="Diminuir altura do gráfico">Alt −</button>
          <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaGrafico(this, 35)" title="Aumentar altura do gráfico">Alt +</button>
          <button type="button" class="ed-mini-btn perigo" style="margin-left:auto" onclick="edRemoverGrafExec(this)" title="Remover do Painel Executivo">✕</button>
        </div>
        <h3 data-editavel="1">{{ cg.titulo }}</h3>
        <div class="exec-fig-corpo">{{ cg.figura }}</div>
      </div>
      {% endfor %}
    </template>
    {% endif %}
  </div>
</section>
{% endif %}

{% if not a.ocultar_resumo or a.modo_editavel %}
<section id="resumo-v{{ v.i }}" class="resumo" data-sec-id="resumo" data-sec-nome="Resumo e achados" data-oculto="{{ '1' if a.ocultar_resumo else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('resumo', 'Resumo e achados')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">Resumo e achados</h2>
  <p class="desc lead" id="resumo-lead-v{{ v.i }}" data-editavel="1">{% if v.resumo %}{{ v.resumo }}{% else %}{{ v.total }} registro(s) no recorte · tempos pela {{ v.estatistica|lower }}.{% endif %}</p>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
    <h3 data-editavel="1">Principais achados</h3>
    <button type="button" class="ed-mini-btn ed-ctl no-print" onclick="edAdicionarAchado()">+ Adicionar achado</button>
  </div>
  {% if v.achados %}<ul class="achados cartoes" id="lista-achados-v{{ v.i }}">{% for t in v.achados %}<li><button type="button" class="ed-achado-del no-print" onclick="this.parentElement.remove()" title="Remover achado">✕</button><span data-editavel="1">{{ t }}</span></li>{% endfor %}</ul>
  {% else %}<ul class="achados cartoes" id="lista-achados-v{{ v.i }}"></ul><p class="vazio">Sem achados no recorte.</p>{% endif %}
  {% if v.observacoes %}<h3 data-editavel="1">Observações do gestor</h3><div class="obs" id="obs-gestor-v{{ v.i }}" data-editavel="1">{{ v.observacoes }}</div>{% endif %}
  {% if v.metas %}
  <details><summary>Ver metas do gestor em tabela</summary>
  <table class="metas">{% for m in v.metas %}
    {% set st = m.status if m.status else ('ok' if m.ok is sameas true else ('ruim' if m.ok is sameas false else none)) %}
    <tr><td class="{{ {'ok':'ok','atencao':'atencao','ruim':'nok'}.get(st,'nd') }}">{{ {'ok':'✔','atencao':'⚠','ruim':'✗'}.get(st,'•') }}</td>
        <td>{{ m.rotulo }}</td><td><b>{{ m.valor_fmt }}</b></td>
        <td class="nd">meta {{ '≥' if m.sentido == '>=' else '≤' }} {{ m.alvo_fmt }}</td></tr>{% endfor %}
  </table>
  </details>
  {% endif %}
</section>
{% endif %}

{% for s in v.secoes %}
<section id="{{ s.id }}-v{{ v.i }}" data-sec-id="{{ s.id }}" data-sec-nome="{{ s.titulo }}" data-extra="{{ '1' if s.extra else '0' }}" data-oculto="{{ '1' if s.oculto else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edAbrirModalGrafico('{{ s.id }}')" title="Criar novo gráfico nesta seção">+ Gráfico</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover seção para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover seção para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('{{ s.id }}', '{{ s.titulo|e }}')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">{{ s.titulo }}</h2>
  <div class="grade-paineis">
  {% for p in s.paineis %}
  {% set plarg = p.largura or (6 if p.meia else 12) %}
  <div class="painel{{ ' meia' if plarg == 6 }}" data-painel-id="{{ p.id }}" data-painel-nome="{{ p.titulo }}" data-larg="{{ plarg }}" data-altura="{{ p.altura or 0 }}" data-custom-graf="{{ '1' if p.custom_graf else '0' }}" data-oculto="{{ '1' if p.oculto else '0' }}" data-ocultar-fig="{{ '1' if p.ocultar_figura else '0' }}" data-ocultar-tab="{{ '1' if p.ocultar_tabela else '0' }}" data-aberta="{{ '1' if p.aberta else '0' }}">
    <div class="ed-painel-bar no-print">
      <button type="button" class="ed-mini-btn" onclick="edMoverPainel(this, -1)" title="Mover painel para trás">←</button>
      <button type="button" class="ed-mini-btn" onclick="edMoverPainel(this, 1)" title="Mover painel para frente">→</button>
      <select class="ed-mini-btn ed-sel-larg" onchange="edDefinirLarguraCard(this, this.value)" title="Largura deste painel/gráfico">
        <option value="3" {{ 'selected' if plarg == 3 }}>25%</option>
        <option value="4" {{ 'selected' if plarg == 4 }}>33%</option>
        <option value="6" {{ 'selected' if plarg == 6 }}>50%</option>
        <option value="8" {{ 'selected' if plarg == 8 }}>66%</option>
        <option value="12" {{ 'selected' if plarg == 12 }}>100%</option>
      </select>
      {% if p.figura %}
      <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaGrafico(this, -35)" title="Diminuir altura do gráfico">Alt −</button>
      <button type="button" class="ed-mini-btn" onclick="edAjustarAlturaGrafico(this, 35)" title="Aumentar altura do gráfico">Alt +</button>
      <button type="button" class="ed-mini-btn" onclick="edPromoverParaExec(this)" title="Enviar/Destacar este gráfico no Painel Executivo">⬆ No Executivo</button>
      <button type="button" class="ed-mini-btn" onclick="edAlternarFigura(this)" title="Mostrar ou ocultar gráfico deste painel">📊 Gráfico</button>
      {% endif %}
      {% if p.linhas %}<button type="button" class="ed-mini-btn" onclick="edAlternarTabela(this)" title="Alternar tabela: recolhida, aberta ou oculta">📋 Tabela</button>{% endif %}
      <button type="button" class="ed-mini-btn perigo" style="margin-left:auto" onclick="edOcultarPainel('{{ p.id }}', '{{ p.titulo|e }}')">✕ Remover</button>
    </div>
    {% if s.paineis|length > 1 or p.titulo != s.titulo %}<h3 data-editavel="1">{{ p.titulo }}</h3>{% endif %}
    {% if p.descricao %}<p class="desc" data-editavel="1">{{ p.descricao }}</p>{% endif %}
    {% if p.kpis %}<div class="kpis mini">{% for k in p.kpis %}<div class="kpi"><div class="rot" data-editavel="1">{{ k.rotulo }}</div>
      <div class="val">{{ k.valor }}</div><div class="nota">{{ k.nota }}</div></div>{% endfor %}</div>{% endif %}
    {% if p.figura %}
      <div class="painel-fig-wrap" {% if p.altura %}style="min-height:{{ p.altura }}px"{% endif %} {{ 'hidden' if p.ocultar_figura }}>{{ p.figura }}</div>
      {% if p.linhas %}
      <div class="painel-tab-wrap" {{ 'hidden' if p.ocultar_tabela }}>
        {% if p.aberta %}<div class="aberta">{{ tabela(p.colunas, p.linhas) }}</div>
        {% else %}<details><summary>Ver tabela</summary>{{ tabela(p.colunas, p.linhas) }}</details>{% endif %}
      </div>
      {% endif %}
    {% elif p.linhas %}
      <div class="painel-tab-wrap" {{ 'hidden' if p.ocultar_tabela }}>
        {% if p.aberta %}<div class="aberta">{{ tabela(p.colunas, p.linhas) }}</div>
        {% else %}<details><summary>Ver tabela</summary>{{ tabela(p.colunas, p.linhas) }}</details>{% endif %}
      </div>
    {% elif not p.kpis and not s.extra %}<p class="vazio">Sem dados no recorte.</p>{% endif %}
  </div>
  {% endfor %}
  </div>
</section>
{% endfor %}
{% endif %}
</div>
{% endfor %}

{% if a.multi and (not a.ocultar_comparar or a.modo_editavel) %}
<section id="comparar" class="comparar" data-sec-id="comparar" data-sec-nome="Comparativo entre períodos" data-oculto="{{ '1' if a.ocultar_comparar else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('comparar', 'Comparativo entre períodos')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">Comparativo entre períodos</h2>
  <p class="desc" data-editavel="1">Escolha dois períodos e compare os indicadores lado a lado, com a variação (Δ) entre eles.
  Os números são os mesmos dos painéis de cada período — nada é recalculado aqui.</p>
  <div class="cmp-sel no-print">
    <div class="cmp-grp"><label>Período A</label><select id="cmp-a"></select></div>
    <button type="button" class="cmp-swap" onclick="cmpTrocar()" title="Inverter A e B" aria-label="Inverter">⇄</button>
    <div class="cmp-grp"><label>Período B</label><select id="cmp-b"></select></div>
  </div>
  <div class="tabela-wrap"><table class="cmp">
    <thead><tr><th>Indicador</th><th class="n" id="cmp-ha">A</th><th class="n" id="cmp-hb">B</th>
      <th class="n">Δ (B − A)</th><th class="n">Δ %</th></tr></thead>
    <tbody id="cmp-corpo"></tbody>
  </table></div>
</section>
{% endif %}

{% if not a.ocultar_leitura or a.modo_editavel %}
<section id="leitura" data-sec-id="leitura" data-sec-nome="Leitura e qualidade" data-oculto="{{ '1' if a.ocultar_leitura else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('leitura', 'Leitura e qualidade')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">Leitura e qualidade</h2>
  <p class="desc" data-editavel="1">O que a leitura fez com as planilhas e o que conferir — nada é descartado em silêncio.</p>
  {% if a.alertas %}<ul class="alertas">{% for al in a.alertas %}<li class="al-{{ al.nivel }}">{{ al.texto }}</li>{% endfor %}</ul>
  {% else %}<p class="vazio">Nenhum problema de leitura ou qualidade detectado.</p>{% endif %}
</section>
{% endif %}

{% if a.base and (not a.ocultar_base or a.modo_editavel) %}
<section id="base" data-sec-id="base" data-sec-nome="Base detalhada" data-oculto="{{ '1' if a.ocultar_base else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('base', 'Base detalhada')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">Base detalhada</h2>
  <p class="desc">{{ a.base.total }} linha(s) do recorte{% if a.base.cortado %} — prévia das primeiras {{ a.base.mostradas }}
    (os indicadores acima usam a base completa){% endif %}.
    {% if a.slug and a.base.cortado %}<a class="baixar-dados" href="/web/r/{{ a.slug }}/dados.csv" title="Baixar a base completa em CSV (Excel)">⬇ Baixar dados completos (CSV)</a>{% endif %}
  </p>
  <details><summary>Abrir prévia</summary>{{ tabela(a.base.colunas, a.base.linhas) }}</details>
</section>
{% endif %}

{% if not a.ocultar_metodologia or a.modo_editavel %}
<section id="metodologia" data-sec-id="metodologia" data-sec-nome="Metodologia" data-oculto="{{ '1' if a.ocultar_metodologia else '0' }}">
  <div class="ed-sec-bar no-print">
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, -1)" title="Mover para cima">↑</button>
    <button type="button" class="ed-mini-btn" onclick="edMoverSecao(this, 1)" title="Mover para baixo">↓</button>
    <button type="button" class="ed-mini-btn perigo" onclick="edOcultarSecao('metodologia', 'Metodologia')">✕ Ocultar seção</button>
  </div>
  <h2 data-editavel="1">Metodologia</h2>
  {% if a.metodologia %}<p class="desc" data-editavel="1">{{ a.metodologia }}</p>{% else %}
  <p class="desc" data-editavel="1">Indicadores calculados sobre o recorte filtrado. Taxas «ponderadas por valor» = soma do numerador ÷
  soma do denominador. Tempos em dias corridos, pela {{ a.estatistica|lower }} (escolhida em ⚙ Editar metas); P90 = 90% dos
  casos em até X dias. Grafias equivalentes (acentos, caixa, pontuação) são unificadas. Cada ocorrência de qualidade aponta
  arquivo, aba e linha para correção na planilha de origem.</p>{% endif %}
</section>
{% endif %}
</main>

<div id="modal-novo-grafico" class="no-print" aria-hidden="true">
  <div class="mng-caixa">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <h3>📊 Adicionar Novo Gráfico Personalizado</h3>
      <button type="button" class="ed-mini-btn" onclick="edFecharModalGrafico()">✕ Fechar</button>
    </div>
    <p class="desc" style="margin:0 0 12px">Crie um gráfico a partir de qualquer tabela do relatório ou digitando os valores manualmente, e escolha onde posicioná-lo.</p>
    <div class="mng-grid">
      <div class="mng-campo">
        <label>Título do gráfico</label>
        <input type="text" id="mng-titulo" placeholder="Ex.: Evolução por convênio">
      </div>
      <div class="mng-campo">
        <label>Tipo de gráfico</label>
        <select id="mng-tipo">
          <option value="barras">Barras horizontais (ranking)</option>
          <option value="colunas">Colunas verticais</option>
          <option value="linha">Linha de tendência (SVG)</option>
          <option value="rosca">Rosca / Proporção (Donut)</option>
        </select>
      </div>
      <div class="mng-campo">
        <label>Onde inserir</label>
        <select id="mng-destino">
          <option value="exec">Painel Executivo (topo)</option>
          {% for s in a.vistas[0].secoes %}
          <option value="{{ s.id }}">Seção: {{ s.titulo }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="mng-campo">
        <label>Largura inicial</label>
        <select id="mng-largura">
          <option value="4">33% (1/3 da linha)</option>
          <option value="6" selected>50% (Meia largura)</option>
          <option value="8">66% (2/3 da linha)</option>
          <option value="12">100% (Largura inteira)</option>
        </select>
      </div>
    </div>
    <div class="mng-grid">
      <div class="mng-campo">
        <label>Fonte dos dados</label>
        <select id="mng-fonte" onchange="edMudarFonteGrafico()">
          <option value="tabela">Extrair de uma tabela do relatório</option>
          <option value="manual">Digitar rótulos e valores manualmente</option>
        </select>
      </div>
      <div class="mng-campo" id="mng-box-tab">
        <label>Tabela de origem</label>
        <select id="mng-tabela" onchange="edPopularColunasFonte()"></select>
      </div>
      <div class="mng-campo" id="mng-box-col-rot">
        <label>Coluna de Rótulo (Categoria / Eixo X)</label>
        <select id="mng-col-rot"></select>
      </div>
      <div class="mng-campo" id="mng-box-col-val">
        <label>Coluna de Valor (Métrica / Eixo Y)</label>
        <select id="mng-col-val"></select>
      </div>
    </div>
    <div id="mng-box-manual" class="mng-campo" style="margin-bottom:12px" hidden>
      <label>Dados manuais (um por linha no formato <code>Rótulo; Valor</code>)</label>
      <textarea id="mng-manual" rows="5" placeholder="Unimed; 14500&#10;Bradesco; 9800&#10;SulAmérica; 6400&#10;Particular; 4200"></textarea>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px">
      <button type="button" class="f-btn sec" onclick="edFecharModalGrafico()">Cancelar</button>
      <button type="button" class="f-btn" onclick="edCriarNovoGrafico()">✦ Inserir gráfico</button>
    </div>
  </div>
</div>
<div id="tip" role="tooltip"></div>
<footer>{{ a.titulo }} · relatório gerado automaticamente · v{{ a.versao }} · contém dados pessoais — uso interno (LGPD)</footer>
<script>
(function () {
  var SLUG = {{ (a.slug or '')|tojson }};
  var tip = document.getElementById('tip');
  document.addEventListener('mousemove', function (e) {
    var el = e.target.closest ? e.target.closest('[data-tip]') : null;
    if (!el) { tip.style.opacity = 0; return; }
    tip.textContent = el.getAttribute('data-tip');
    var x = e.clientX + 14, y = e.clientY + 14, r = tip.getBoundingClientRect();
    if (x + r.width > window.innerWidth - 8) x = e.clientX - r.width - 14;
    if (y + r.height > window.innerHeight - 8) y = e.clientY - r.height - 14;
    tip.style.left = x + 'px'; tip.style.top = y + 'px'; tip.style.opacity = 1;
  });
  var periodo = document.getElementById('periodo');
  if (periodo) {
    periodo.addEventListener('change', function () {
      var i = this.value;
      var vistas = document.querySelectorAll('.vista');
      for (var k = 0; k < vistas.length; k++) { vistas[k].hidden = (vistas[k].getAttribute('data-i') !== i); }
      var links = document.querySelectorAll('nav.indice a[data-sec]');
      for (var j = 0; j < links.length; j++) { links[j].setAttribute('href', '#' + links[j].getAttribute('data-sec') + '-v' + i); }
      window.scrollTo(0, 0);
    });
  }
  var raiz = document.documentElement;
  try { var t = localStorage.getItem('tema-relatorio'); if (t) raiz.setAttribute('data-theme', t); } catch (e) {}
  document.getElementById('tema').addEventListener('click', function () {
    var escuro = raiz.getAttribute('data-theme') === 'dark' ||
      (!raiz.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    var novo = escuro ? 'light' : 'dark';
    raiz.setAttribute('data-theme', novo);
    try { localStorage.setItem('tema-relatorio', novo); } catch (e) {}
  });

  // ---- comparativo entre períodos (modo Comparar) ----
  var CMP = {{ a.comparar|tojson }};
  var selA = document.getElementById('cmp-a'), selB = document.getElementById('cmp-b');
  if (CMP && CMP.length >= 2 && selA && selB) {
    for (var ci = 0; ci < CMP.length; ci++) {
      var oa = document.createElement('option'); oa.value = ci; oa.textContent = CMP[ci].rotulo; selA.appendChild(oa);
      var ob = document.createElement('option'); ob.value = ci; ob.textContent = CMP[ci].rotulo; selB.appendChild(ob);
    }
    selA.value = 0; selB.value = CMP.length - 1;
    var nbr = function (v, casas) {
      return v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas });
    };
    var fmtNum = function (v, f) {
      if (v === null || v === undefined || isNaN(v)) return '—';
      if (f === 'moeda') return 'R$ ' + nbr(v, 2);
      if (f === 'pct') return nbr(v * 100, 1) + '%';
      if (f === 'dias') return nbr(v, Number.isInteger(v) ? 0 : 1) + ' dias';
      if (f === 'int') return nbr(Math.round(v), 0);
      return nbr(v, 2);
    };
    var esc = function (s) {
      return String(s).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; });
    };
    var cmpRender = function () {
      var A = CMP[+selA.value], B = CMP[+selB.value];
      document.getElementById('cmp-ha').textContent = A.rotulo;
      document.getElementById('cmp-hb').textContent = B.rotulo;
      var mapA = {};
      for (var i = 0; i < A.kpis.length; i++) mapA[A.kpis[i].chave] = A.kpis[i];
      var corpo = document.getElementById('cmp-corpo');
      corpo.innerHTML = '';
      for (var j = 0; j < B.kpis.length; j++) {
        var kb = B.kpis[j], ka = mapA[kb.chave];
        var va = ka ? ka.valor : '—', vb = kb.valor;
        var dAbs = '—', dPct = '—', classe = 'neutro', seta = '';
        if (ka && ka.num !== null && kb.num !== null) {
          var diff = kb.num - ka.num;
          dAbs = (diff > 0 ? '+' : '') + fmtNum(diff, kb.fmt);
          seta = diff > 0 ? '▲' : (diff < 0 ? '▼' : '▬');
          if (ka.num !== 0) {
            var p = diff / Math.abs(ka.num);
            dPct = (diff > 0 ? '+' : '') + nbr(p * 100, 1) + '%';
          }
          if (kb.sentido === '+') classe = diff > 0 ? 'bom' : (diff < 0 ? 'ruim' : 'neutro');
          else if (kb.sentido === '-') classe = diff > 0 ? 'ruim' : (diff < 0 ? 'bom' : 'neutro');
        }
        var tr = document.createElement('tr');
        tr.innerHTML = '<td>' + esc(kb.rotulo) + '</td><td class="n">' + esc(va) + '</td><td class="n">' + esc(vb) +
          '</td><td class="n delta-cell ' + classe + '">' + esc(dAbs) + '</td>' +
          '<td class="n delta-cell ' + classe + '"><span class="seta">' + seta + '</span> ' + esc(dPct) + '</td>';
        corpo.appendChild(tr);
      }
    };
    window.cmpTrocar = function () { var t = selA.value; selA.value = selB.value; selB.value = t; cmpRender(); };
    selA.addEventListener('change', cmpRender);
    selB.addEventListener('change', cmpRender);
    cmpRender();
  }

  // ---- Personalização do Painel Executivo (Gestor / ADM) ----
  window.execToggleCfg = function () {
    var box = document.getElementById('exec-cfg-box');
    if (box) box.hidden = !box.hidden;
  };
  window.execMoverItem = function (btn, dir) {
    var item = btn.closest('.exec-cfg-item');
    if (!item || !item.parentElement) return;
    var pai = item.parentElement;
    if (dir < 0 && item.previousElementSibling) pai.insertBefore(item, item.previousElementSibling);
    else if (dir > 0 && item.nextElementSibling) pai.insertBefore(item.nextElementSibling, item);
    window.execAplicarLocal();
  };
  window.execMarcarDestaque = function (chave) {
    var itens = document.querySelectorAll('#exec-cfg-kpis .exec-cfg-item');
    for (var i = 0; i < itens.length; i++) {
      var b = itens[i].querySelector('.exec-cfg-mini');
      if (!b) continue;
      if (itens[i].getAttribute('data-chave') === chave) b.classList.toggle('ativo');
      else b.classList.remove('ativo');
    }
    window.execAplicarLocal();
  };
  window.execColetarCfg = function () {
    var kpis = [], destaque = '', kpisLargura = {}, kpisRotulos = {};
    var contKpi = document.getElementById('kpis-exec-v0');
    var ik = document.querySelectorAll('#exec-cfg-kpis .exec-cfg-item');
    for (var i = 0; i < ik.length; i++) {
      var ck = ik[i].querySelector('.exec-ck-kpi');
      var st = ik[i].querySelector('.exec-cfg-mini');
      var ch = ik[i].getAttribute('data-chave') || '';
      if (ck && ck.checked) kpis.push(ck.value);
      if (st && st.classList.contains('ativo')) destaque = ch;
    }
    if (contKpi) {
      var cards = contKpi.querySelectorAll('.kpi-exec');
      var kpisDom = [];
      for (var c = 0; c < cards.length; c++) {
        var chK = cards[c].getAttribute('data-chave');
        var spK = parseInt(cards[c].getAttribute('data-span') || '1', 10);
        kpisLargura[chK] = spK;
        var rotEl = cards[c].querySelector('.rot');
        if (rotEl) kpisRotulos[chK] = rotEl.textContent.trim();
        if (cards[c].getAttribute('data-oculto') !== '1') kpisDom.push(chK);
        if (cards[c].classList.contains('destaque')) destaque = chK;
      }
      if (kpisDom.length) kpis = kpisDom;
    }
    var graficos = [], graficosLayout = {};
    var contGraf = document.getElementById('exec-graficos-v0');
    if (contGraf) {
      var figs = contGraf.querySelectorAll('.exec-fig');
      for (var f = 0; f < figs.length; f++) {
        var gid = figs[f].getAttribute('data-gid');
        if (!gid) continue;
        graficos.push(gid);
        var h3 = figs[f].querySelector('h3');
        var corpo = figs[f].querySelector('.exec-fig-corpo');
        var ehCustom = figs[f].getAttribute('data-custom') === '1';
        graficosLayout[gid] = {
          largura: parseInt(figs[f].getAttribute('data-larg') || '6', 10),
          altura: parseInt(figs[f].getAttribute('data-altura') || '0', 10),
          titulo: h3 ? h3.textContent.trim() : '',
          custom: ehCustom,
          figura_html: ehCustom && corpo ? corpo.innerHTML : undefined
        };
      }
    }
    var secExec = document.getElementById('exec-v0');
    var titEl = document.getElementById('exec-titulo-v0');
    return {
      kpis: kpis,
      kpi_destaque: destaque,
      kpis_largura: kpisLargura,
      kpis_rotulos: kpisRotulos,
      graficos: graficos,
      graficos_layout: graficosLayout,
      tamanho: secExec ? (secExec.getAttribute('data-tam') || 'padrao') : 'padrao',
      altura: secExec ? parseInt(secExec.getAttribute('data-altura') || '0', 10) : 0,
      largura_pagina: document.body.getAttribute('data-largura') || 'padrao',
      titulo: titEl ? titEl.textContent.trim() : 'Painel executivo'
    };
  };
  window.execAplicarLocal = function () {
    var kpis = [], destaque = '';
    var ik = document.querySelectorAll('#exec-cfg-kpis .exec-cfg-item');
    for (var i = 0; i < ik.length; i++) {
      var ck = ik[i].querySelector('.exec-ck-kpi');
      var st = ik[i].querySelector('.exec-cfg-mini');
      if (ck && ck.checked) kpis.push(ck.value);
      if (st && st.classList.contains('ativo')) destaque = ik[i].getAttribute('data-chave') || '';
    }
    var contKpi = document.getElementById('kpis-exec-v0');
    if (contKpi) {
      var mapaK = {};
      var cards = contKpi.querySelectorAll('.kpi-exec');
      for (var c = 0; c < cards.length; c++) {
        var ch = cards[c].getAttribute('data-chave');
        mapaK[ch] = cards[c];
        cards[c].setAttribute('data-oculto', '1');
        cards[c].classList.remove('destaque');
      }
      for (var m = 0; m < ik.length; m++) {
        var ch2 = ik[m].getAttribute('data-chave');
        if (mapaK[ch2]) contKpi.appendChild(mapaK[ch2]);
      }
      for (var k = 0; k < kpis.length; k++) {
        var card = mapaK[kpis[k]];
        if (card) {
          card.setAttribute('data-oculto', '0');
          if (destaque && kpis[k] === destaque) {
            card.classList.add('destaque');
            card.setAttribute('data-span', '2');
          }
        }
      }
    }
    var grafIds = [];
    var ig = document.querySelectorAll('#exec-cfg-graficos .exec-cfg-item');
    for (var j = 0; j < ig.length; j++) {
      var cg = ig[j].querySelector('.exec-ck-graf');
      if (cg && cg.checked) grafIds.push(cg.value);
    }
    var contGraf = document.getElementById('exec-graficos-v0');
    var tpl = document.getElementById('exec-catalogo-graficos-tpl');
    if (contGraf && tpl) {
      var existentes = {};
      var atuais = contGraf.querySelectorAll('.exec-fig');
      for (var a = 0; a < atuais.length; a++) {
        existentes[atuais[a].getAttribute('data-gid')] = atuais[a];
      }
      contGraf.innerHTML = '';
      for (var g = 0; g < grafIds.length; g++) {
        var gid = grafIds[g];
        if (existentes[gid]) {
          contGraf.appendChild(existentes[gid]);
        } else {
          var orig = tpl.content.querySelector('[data-gid="' + gid + '"]');
          if (orig) contGraf.appendChild(orig.cloneNode(true));
        }
      }
      for (var idEx in existentes) {
        if (existentes[idEx].getAttribute('data-custom') === '1' && grafIds.indexOf(idEx) === -1) {
          contGraf.appendChild(existentes[idEx]);
        }
      }
      contGraf.hidden = (contGraf.children.length === 0);
    }
  };
  window.execSalvarServidor = function () {
    if (!SLUG) return;
    var msg = document.getElementById('exec-cfg-msg');
    if (msg) msg.textContent = 'Salvando…';
    fetch('/web/r/' + encodeURIComponent(SLUG) + '/painel-executivo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(window.execColetarCfg())
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (msg) msg.textContent = d.ok ? '✔ Painel Executivo salvo para este relatório!' : ('Erro: ' + (d.erro || 'falha'));
    }).catch(function () {
      if (msg) msg.textContent = 'Erro ao salvar no servidor.';
    });
  };
  window.execRestaurarPadrao = function () {
    var cks = document.querySelectorAll('#exec-cfg-kpis .exec-ck-kpi');
    for (var i = 0; i < cks.length; i++) cks[i].checked = true;
    var sts = document.querySelectorAll('#exec-cfg-kpis .exec-cfg-mini');
    for (var s = 0; s < sts.length; s++) sts[s].classList.remove('ativo');
    var firstSt = document.querySelector('#exec-cfg-kpis .exec-cfg-item .exec-cfg-mini');
    if (firstSt) firstSt.classList.add('ativo');
    var gks = document.querySelectorAll('#exec-cfg-graficos .exec-ck-graf');
    for (var g = 0; g < gks.length; g++) gks[g].checked = (g < 2);
    window.execAplicarLocal();
    if (SLUG) {
      fetch('/web/r/' + encodeURIComponent(SLUG) + '/painel-executivo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reset: true })
      }).then(function () {
        var msg = document.getElementById('exec-cfg-msg');
        if (msg) msg.textContent = '✔ Restaurado ao padrão automático.';
      });
    }
  };

  // ---- MODO VERSÃO EDITÁVEL (2ª versão do relatório) ----
  function edAtualizarEditaveis(ativo) {
    var els = document.querySelectorAll('[data-editavel="1"]');
    for (var i = 0; i < els.length; i++) {
      if (ativo) els[i].setAttribute('contenteditable', 'true');
      else els[i].removeAttribute('contenteditable');
    }
  }
  function edAtualizarListaOcultos() {
    var lista = document.getElementById('ed-lista-ocultos');
    var cont = document.getElementById('ed-n-ocultos');
    if (!lista || !cont) return;
    lista.innerHTML = '';
    var n = 0;
    var secs = document.querySelectorAll('section[data-sec-id][data-oculto="1"]');
    for (var i = 0; i < secs.length; i++) {
      if (secs[i].closest('.vista') && secs[i].closest('.vista').hidden) continue;
      n++;
      (function (el) {
        var sid = el.getAttribute('data-sec-id');
        var nome = el.getAttribute('data-sec-nome') || sid;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'f-chip';
        b.textContent = '+ Seção: ' + nome;
        b.onclick = function () { el.setAttribute('data-oculto', '0'); edAtualizarListaOcultos(); };
        lista.appendChild(b);
      })(secs[i]);
    }
    var pns = document.querySelectorAll('.vista:not([hidden]) .painel[data-painel-id][data-oculto="1"]');
    for (var j = 0; j < pns.length; j++) {
      n++;
      (function (el) {
        var nome = el.getAttribute('data-painel-nome') || 'Painel';
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'f-chip';
        b.textContent = '+ Painel: ' + nome;
        b.onclick = function () { el.setAttribute('data-oculto', '0'); edAtualizarListaOcultos(); };
        lista.appendChild(b);
      })(pns[j]);
    }
    cont.textContent = String(n);
  }
  window.edAtivarModo = function () {
    document.body.classList.add('modo-editavel');
    edAtualizarEditaveis(true);
    edAtualizarListaOcultos();
    var btn = document.getElementById('btn-gerar-editavel');
    if (btn) btn.textContent = '✎ Editando versão';
  };
  window.edSairModo = function () {
    document.body.classList.remove('modo-editavel');
    edAtualizarEditaveis(false);
    var btn = document.getElementById('btn-gerar-editavel');
    if (btn) btn.textContent = '✎ Editar versão';
  };
  window.edToggleGavetaOcultos = function () {
    var g = document.getElementById('ed-gaveta-ocultos');
    if (g) g.classList.toggle('aberta');
  };
  window.edOcultarSecao = function (secId) {
    var secs = document.querySelectorAll('section[data-sec-id="' + secId + '"]');
    for (var i = 0; i < secs.length; i++) secs[i].setAttribute('data-oculto', '1');
    edAtualizarListaOcultos();
  };
  window.edOcultarPainel = function (pid) {
    var pns = document.querySelectorAll('.painel[data-painel-id="' + pid + '"]');
    for (var i = 0; i < pns.length; i++) pns[i].setAttribute('data-oculto', '1');
    edAtualizarListaOcultos();
  };
  window.edRestaurarTudo = function () {
    var ocultos = document.querySelectorAll('section[data-oculto="1"], .painel[data-oculto="1"]');
    for (var i = 0; i < ocultos.length; i++) ocultos[i].setAttribute('data-oculto', '0');
    edAtualizarListaOcultos();
  };
  window.edMoverSecao = function (btn, dir) {
    var sec = btn.closest('section');
    if (!sec || !sec.parentElement) return;
    var pai = sec.parentElement;
    var irmao = dir < 0 ? sec.previousElementSibling : sec.nextElementSibling;
    while (irmao && (irmao.tagName !== 'SECTION' || irmao.getAttribute('data-oculto') === '1')) {
      irmao = dir < 0 ? irmao.previousElementSibling : irmao.nextElementSibling;
    }
    if (!irmao) return;
    if (dir < 0) pai.insertBefore(sec, irmao);
    else pai.insertBefore(irmao, sec);
  };
  window.edMoverPainel = function (btn, dir) {
    var pn = btn.closest('.painel');
    if (!pn || !pn.parentElement) return;
    var pai = pn.parentElement;
    var irmao = dir < 0 ? pn.previousElementSibling : pn.nextElementSibling;
    while (irmao && (!irmao.classList.contains('painel') || irmao.getAttribute('data-oculto') === '1')) {
      irmao = dir < 0 ? irmao.previousElementSibling : irmao.nextElementSibling;
    }
    if (!irmao) return;
    if (dir < 0) pai.insertBefore(pn, irmao);
    else pai.insertBefore(irmao, pn);
  };
  window.edAlternarLargura = function (btn) {
    var pn = btn.closest('.painel, .exec-fig');
    if (!pn) return;
    var atual = parseInt(pn.getAttribute('data-larg') || (pn.classList.contains('meia') ? '6' : '12'), 10);
    var novo = atual === 6 ? 12 : 6;
    window.edDefinirLarguraCard(btn, novo);
  };
  window.edDefinirLarguraCard = function (el, valor) {
    var card = el.closest('.painel, .exec-fig');
    if (!card) return;
    var n = parseInt(valor || '6', 10);
    card.setAttribute('data-larg', String(n));
    if (card.classList.contains('painel')) {
      if (n === 6) card.classList.add('meia');
      else card.classList.remove('meia');
    }
    var sel = card.querySelector('.ed-sel-larg');
    if (sel && sel.value !== String(n)) sel.value = String(n);
  };
  window.edAjustarAlturaGrafico = function (btn, delta) {
    var card = btn.closest('.painel, .exec-fig');
    if (!card) return;
    var wrap = card.querySelector('.painel-fig-wrap, .exec-fig-corpo');
    var svg = card.querySelector('svg.grafico');
    var atual = parseInt(card.getAttribute('data-altura') || '0', 10);
    if (!atual) {
      if (svg && svg.getBoundingClientRect().height > 40) atual = Math.round(svg.getBoundingClientRect().height);
      else if (wrap && wrap.getBoundingClientRect().height > 40) atual = Math.round(wrap.getBoundingClientRect().height);
      else atual = 220;
    }
    var nova = Math.max(110, Math.min(760, atual + delta));
    card.setAttribute('data-altura', String(nova));
    if (wrap) wrap.style.minHeight = nova + 'px';
    if (svg) svg.style.height = nova + 'px';
  };
  window.edMudarTamExec = function (tam) {
    var secs = document.querySelectorAll('section.exec');
    for (var i = 0; i < secs.length; i++) secs[i].setAttribute('data-tam', tam);
    var s1 = document.getElementById('ed-sel-tam-exec');
    if (s1 && s1.value !== tam) s1.value = tam;
    var s2 = document.getElementById('exec-cfg-tam');
    if (s2 && s2.value !== tam) s2.value = tam;
  };
  window.edCiclarTamExec = function () {
    var sec = document.getElementById('exec-v0');
    var ord = ['compacto', 'padrao', 'expandido'];
    var at = sec ? (sec.getAttribute('data-tam') || 'padrao') : 'padrao';
    var prox = ord[(ord.indexOf(at) + 1) % ord.length];
    window.edMudarTamExec(prox);
  };
  window.edAjustarAlturaExec = function (delta) {
    var sec = document.getElementById('exec-v0');
    if (!sec) return;
    var at = parseInt(sec.getAttribute('data-altura') || '0', 10);
    if (!at) at = Math.round(sec.getBoundingClientRect().height || 260);
    var nova = Math.max(140, Math.min(1200, at + delta));
    sec.setAttribute('data-altura', String(nova));
    sec.style.minHeight = nova + 'px';
  };
  window.edMudarLarguraPagina = function (larg) {
    document.body.setAttribute('data-largura', larg || 'padrao');
    var sel = document.getElementById('ed-sel-larg-pag');
    if (sel && sel.value !== larg) sel.value = larg;
  };
