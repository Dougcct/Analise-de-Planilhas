  function construirHtmlFiguraCustom(tipo, pares) {
    var cores = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)', 'var(--s5)', 'var(--s6)'];
    var maxV = 0, somaV = 0;
    for (var i = 0; i < pares.length; i++) {
      if (pares[i].val > maxV) maxV = pares[i].val;
      if (pares[i].val > 0) somaV += pares[i].val;
    }
    if (maxV <= 0) maxV = 1;
    if (tipo === 'barras') {
      var htmlB = '<div class="barras">';
      for (var b = 0; b < pares.length; b++) {
        var pct = Math.max(2, Math.round((pares[b].val / maxV) * 100));
        var cor = cores[b % cores.length];
        htmlB += '<div class="barra-linha"><span class="barra-rot" title="' + escHtml(pares[b].rot) + '">' + escHtml(pares[b].rot) + '</span>' +
          '<div class="barra-trilho"><span class="barra" style="width:' + pct + '%;--cor:' + cor + '"></span></div>' +
          '<span class="barra-val">' + escHtml(pares[b].fmt) + '</span></div>';
      }
      return htmlB + '</div>';
    }
    if (tipo === 'rosca') {
      var r = 52, C = 2 * Math.PI * r, acum = 0;
      var svgC = '<div class="rosca-wrap"><svg class="rosca-svg" viewBox="0 0 140 140">';
      var leg = '<ul class="rosca-leg">';
      var baseSoma = somaV > 0 ? somaV : 1;
      for (var d = 0; d < pares.length; d++) {
        var frac = Math.max(0, pares[d].val) / baseSoma;
        var comp = (frac * C).toFixed(2);
        var off = (-acum * C).toFixed(2);
        acum += frac;
        var corD = cores[d % cores.length];
        svgC += '<circle cx="70" cy="70" r="' + r + '" fill="none" stroke="' + corD + '" stroke-width="20" stroke-dasharray="' + comp + ' ' + C.toFixed(2) + '" stroke-dashoffset="' + off + '" transform="rotate(-90 70 70)" data-tip="' + escHtml(pares[d].rot + ': ' + pares[d].fmt) + '"></circle>';
        leg += '<li><i style="background:' + corD + '"></i><span class="rz-nome">' + escHtml(pares[d].rot) + '</span><b>' + escHtml(pares[d].fmt) + '</b><span class="rz-pct">' + (frac * 100).toFixed(1).replace('.', ',') + '%</span></li>';
      }
      svgC += '<text x="70" y="74" text-anchor="middle" class="rz-num">' + pares.length + '</text><text x="70" y="88" text-anchor="middle" class="rz-rot">itens</text></svg>';
      return svgC + leg + '</ul></div>';
    }
    // Colunas ou Linha em SVG
    var W = 560, H = 220, padL = 44, padR = 18, padT = 24, padB = 42;
    var plotW = W - padL - padR, plotH = H - padT - padB;
    var n = pares.length;
    var svg = '<svg class="grafico" viewBox="0 0 ' + W + ' ' + H + '">';
    svg += '<line class="grade" x1="' + padL + '" y1="' + padT + '" x2="' + (W - padR) + '" y2="' + padT + '"></line>';
    svg += '<line class="grade" x1="' + padL + '" y1="' + Math.round(padT + plotH / 2) + '" x2="' + (W - padR) + '" y2="' + Math.round(padT + plotH / 2) + '"></line>';
    svg += '<line class="base" x1="' + padL + '" y1="' + (padT + plotH) + '" x2="' + (W - padR) + '" y2="' + (padT + plotH) + '"></line>';
    if (tipo === 'colunas') {
      var step = plotW / Math.max(1, n);
      var bw = Math.max(12, Math.min(48, Math.round(step * 0.62)));
      for (var k = 0; k < n; k++) {
        var hBar = Math.max(3, Math.round((Math.max(0, pares[k].val) / maxV) * plotH));
        var x = Math.round(padL + k * step + (step - bw) / 2);
        var y = padT + plotH - hBar;
        var cx = Math.round(x + bw / 2);
        var rotCurto = pares[k].rot.length > 12 ? pares[k].rot.slice(0, 11) + '…' : pares[k].rot;
        svg += '<rect x="' + x + '" y="' + y + '" width="' + bw + '" height="' + hBar + '" rx="4" fill="' + cores[k % cores.length] + '" data-tip="' + escHtml(pares[k].rot + ': ' + pares[k].fmt) + '"></rect>';
        svg += '<text class="valor" x="' + cx + '" y="' + (y - 5) + '" text-anchor="middle">' + escHtml(pares[k].fmt) + '</text>';
        svg += '<text class="eixo" x="' + cx + '" y="' + (padT + plotH + 16) + '" text-anchor="middle">' + escHtml(rotCurto) + '</text>';
      }
    } else {
      var pts = [];
      for (var l = 0; l < n; l++) {
        var px = n === 1 ? Math.round(padL + plotW / 2) : Math.round(padL + (l / (n - 1)) * plotW);
        var py = Math.round(padT + plotH - (Math.max(0, pares[l].val) / maxV) * plotH);
        pts.push({ x: px, y: py, p: pares[l] });
      }
      var poly = pts.map(function (pt) { return pt.x + ',' + pt.y; }).join(' ');
      svg += '<polyline fill="none" stroke="var(--s1)" stroke-width="2.5" points="' + poly + '"></polyline>';
      for (var pIdx = 0; pIdx < pts.length; pIdx++) {
        var pt = pts[pIdx];
        var rCurto = pt.p.rot.length > 10 ? pt.p.rot.slice(0, 9) + '…' : pt.p.rot;
        svg += '<circle cx="' + pt.x + '" cy="' + pt.y + '" r="4.5" fill="var(--s1)" data-tip="' + escHtml(pt.p.rot + ': ' + pt.p.fmt) + '"></circle>';
        svg += '<text class="valor" x="' + pt.x + '" y="' + (pt.y - 8) + '" text-anchor="middle">' + escHtml(pt.p.fmt) + '</text>';
        svg += '<text class="eixo" x="' + pt.x + '" y="' + (padT + plotH + 16) + '" text-anchor="middle">' + escHtml(rCurto) + '</text>';
      }
    }
    return svg + '</svg>';
  }
