# Segredos de PRODUÇÃO (fase 7, DOCS/18 §7). Copie para `.env` e preencha.
# O `.env` NÃO vai para o git (está no .gitignore). Nunca comite segredos reais.
#   cp .env.exemplo .env   &&   edite os valores

# Senha do PostgreSQL (o usuário do banco é "analise").
POSTGRES_PASSWORD=troque-esta-senha-forte

# Senha que CIFRA os backups (AES-256). Sem ela, não há como restaurar — guarde com segurança.
BACKUP_PASSPHRASE=troque-esta-frase-de-backup

# Domínio interno do servidor (o Caddy emite um certificado interno para ele).
DOMINIO=analise.local

# Versão mínima de cliente aceita pela API (abaixo disso → 426). Normalmente igual à do servidor.
VERSAO_MINIMA_CLIENTE=1.0.0

# (Fase futura) segredo do HMAC de pseudônimos da anonimização por coluna — DOCS/18 §2.
# SEGREDO_PSEUDONIMO=troque-este-segredo
